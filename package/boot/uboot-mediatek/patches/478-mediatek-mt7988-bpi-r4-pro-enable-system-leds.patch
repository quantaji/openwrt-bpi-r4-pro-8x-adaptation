From 3b51198d049daccf335a71d069798896db33406a Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 21 Aug 2026 21:34:45 -0700
Subject: [PATCH] arm: mediatek: enable BPI-R4 Pro system LEDs

Use the Linux upstream ACT and ERR identities for the two system LEDs and enable software blinking in the SD, eMMC, and SPI-NAND configurations.

The DTS naming is adapted from Linux commit 52869bbbcfbde006948c0fe1f8f08d650a9b0093 ("arm64: dts: mediatek: mt7988a-bpi-r4pro: update gpio-leds"), originally authored by Frank Wunderlich <frank-w@public-files.de>.

Signed-off-by: Codex <codex@openai.com>
---
 arch/arm/dts/mt7988a-bananapi-bpi-r4-pro.dtsi          | 4 ++--
 configs/mt7988a_bananapi_bpi-r4-pro-8x-emmc_defconfig  | 1 +
 configs/mt7988a_bananapi_bpi-r4-pro-8x-sdmmc_defconfig | 1 +
 configs/mt7988a_bananapi_bpi-r4-pro-8x-snand_defconfig | 1 +
 4 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm/dts/mt7988a-bananapi-bpi-r4-pro.dtsi b/arch/arm/dts/mt7988a-bananapi-bpi-r4-pro.dtsi
index 40eaae7..35b316b 100644
--- a/arch/arm/dts/mt7988a-bananapi-bpi-r4-pro.dtsi
+++ b/arch/arm/dts/mt7988a-bananapi-bpi-r4-pro.dtsi
@@ -56,12 +56,12 @@
 		compatible = "gpio-leds";
 
 		led_red: sys-led-red {
-			label = "red:status";
+			label = "red:fault";
 			gpios = <&pca9555 15 GPIO_ACTIVE_HIGH>;
 		};
 
 		led_blue: sys-led-blue {
-			label = "blue:status";
+			label = "blue:activity";
 			gpios = <&pca9555 14 GPIO_ACTIVE_HIGH>;
 		};
 	};
diff --git a/configs/mt7988a_bananapi_bpi-r4-pro-8x-emmc_defconfig b/configs/mt7988a_bananapi_bpi-r4-pro-8x-emmc_defconfig
index ee8d9be..d8c394c 100644
--- a/configs/mt7988a_bananapi_bpi-r4-pro-8x-emmc_defconfig
+++ b/configs/mt7988a_bananapi_bpi-r4-pro-8x-emmc_defconfig
@@ -107,6 +107,7 @@ CONFIG_DM_GPIO=y
 CONFIG_DM_PCA953X=y
 CONFIG_LED=y
 CONFIG_LED_BLINK=y
+CONFIG_LED_SW_BLINK=y
 CONFIG_LED_GPIO=y
 CONFIG_SUPPORT_EMMC_BOOT=y
 CONFIG_MMC_HS200_SUPPORT=y
diff --git a/configs/mt7988a_bananapi_bpi-r4-pro-8x-sdmmc_defconfig b/configs/mt7988a_bananapi_bpi-r4-pro-8x-sdmmc_defconfig
index 6bc0461..7a375d2 100644
--- a/configs/mt7988a_bananapi_bpi-r4-pro-8x-sdmmc_defconfig
+++ b/configs/mt7988a_bananapi_bpi-r4-pro-8x-sdmmc_defconfig
@@ -108,6 +108,7 @@ CONFIG_DM_GPIO=y
 CONFIG_DM_PCA953X=y
 CONFIG_LED=y
 CONFIG_LED_BLINK=y
+CONFIG_LED_SW_BLINK=y
 CONFIG_LED_GPIO=y
 CONFIG_SUPPORT_EMMC_BOOT=y
 CONFIG_MMC_HS200_SUPPORT=y
diff --git a/configs/mt7988a_bananapi_bpi-r4-pro-8x-snand_defconfig b/configs/mt7988a_bananapi_bpi-r4-pro-8x-snand_defconfig
index f8920bb..dcd16b4 100644
--- a/configs/mt7988a_bananapi_bpi-r4-pro-8x-snand_defconfig
+++ b/configs/mt7988a_bananapi_bpi-r4-pro-8x-snand_defconfig
@@ -107,6 +107,7 @@ CONFIG_DM_GPIO=y
 CONFIG_DM_PCA953X=y
 CONFIG_LED=y
 CONFIG_LED_BLINK=y
+CONFIG_LED_SW_BLINK=y
 CONFIG_LED_GPIO=y
 CONFIG_SUPPORT_EMMC_BOOT=y
 CONFIG_MMC_HS200_SUPPORT=y
-- 
