+
+#include <mapmem.h>
+#include <net.h>
+#include <net/recovery_http.h>
+#include <net/tcp.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+
+#define RECOVERY_HTTP_PORT		80
+#define RECOVERY_HTTP_HEADER_SIZE	4096
+#define RECOVERY_HTTP_BODY_SIZE		4096
+#define RECOVERY_HTTP_RESPONSE_SIZE	256
+
+enum recovery_http_request_kind {
+	RECOVERY_HTTP_REQUEST_NONE,
+	RECOVERY_HTTP_REQUEST_PAGE,
+	RECOVERY_HTTP_REQUEST_UPLOAD,
+	RECOVERY_HTTP_REQUEST_BOOT,
+};
+
+struct recovery_http_connection {
+	enum recovery_http_request_kind kind;
+
+	char header[RECOVERY_HTTP_HEADER_SIZE + 1];
+	u32 header_length;
+	bool header_parsed;
+
+	ulong content_length;
+	bool receiving;
+
+	char response_header[RECOVERY_HTTP_RESPONSE_SIZE];
+	char response_body[RECOVERY_HTTP_BODY_SIZE];
+	u32 response_header_length;
+	u32 response_body_length;
+	bool response_ready;
+	bool response_acked;
+	bool boot_after_close;
+};
+
+struct recovery_http_server {
+	struct recovery_http_request request;
+	struct recovery_http_result *result;
+	struct recovery_http_connection connection;
+
+	ulong uploaded_size;
+	bool upload_valid;
+};
+
+static struct recovery_http_server recovery_http;
+
