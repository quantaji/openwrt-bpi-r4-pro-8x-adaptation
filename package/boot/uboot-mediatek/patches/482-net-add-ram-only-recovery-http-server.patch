+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __NET_RECOVERY_HTTP_H__
+#define __NET_RECOVERY_HTTP_H__
+
+#include <linux/types.h>
+
+struct recovery_http_request {
+	ulong load_addr;
+	ulong max_size;
+	ulong load_limit;
+	const char *initial_status;
+	void (*set_receiving)(bool receiving);
+};
+
+struct recovery_http_result {
+	ulong received_size;
+};
+
+int recovery_http_run(const struct recovery_http_request *request,
+		      struct recovery_http_result *result);
+void recovery_http_start_server(void);
+
+#endif
