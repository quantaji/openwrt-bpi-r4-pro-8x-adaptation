+static int recovery_http_find_header_end(const char *header, u32 length)
+{
+	u32 offset;
+
+	for (offset = 0; offset + 3 < length; offset++) {
+		if (!memcmp(header + offset, "\r\n\r\n", 4))
+			return offset + 4;
+	}
+
+	return -ENOENT;
+}
+
+static int recovery_http_parse_request(struct recovery_http_connection *connection)
+{
+	char *line = connection->header;
+	char *line_end;
+	char *value;
+	char *value_end;
+	ulong content_length = 0;
+	bool content_length_seen = false;
+	bool content_type_seen = false;
+
+	line_end = strstr(line, "\r\n");
+	if (!line_end)
+		return -EINVAL;
+	*line_end = '\0';
+
+	if (!strcmp(line, "GET / HTTP/1.0") ||
+	    !strcmp(line, "GET / HTTP/1.1")) {
+		connection->kind = RECOVERY_HTTP_REQUEST_PAGE;
+	} else if (!strcmp(line, "POST /upload HTTP/1.0") ||
+		   !strcmp(line, "POST /upload HTTP/1.1")) {
+		connection->kind = RECOVERY_HTTP_REQUEST_UPLOAD;
+	} else if (!strcmp(line, "POST /boot HTTP/1.0") ||
+		   !strcmp(line, "POST /boot HTTP/1.1")) {
+		connection->kind = RECOVERY_HTTP_REQUEST_BOOT;
+	} else if (!strncmp(line, "GET ", 4) ||
+		   !strncmp(line, "POST ", 5)) {
+		return -ENOENT;
+	} else {
+		return -ENOSYS;
+	}
+
+	line = line_end + 2;
+	while (line < connection->header + connection->header_length) {
+		line_end = strstr(line, "\r\n");
+		if (!line_end)
+			return -EINVAL;
+		*line_end = '\0';
+		if (!*line)
+			break;
+
+		if (!strncasecmp(line, "Content-Length:", 15)) {
+			if (content_length_seen)
+				return -EINVAL;
+			content_length_seen = true;
+			value = line + 15;
+			while (*value == ' ' || *value == '\t')
+				value++;
+			if (*value < '0' || *value > '9')
+				return -EINVAL;
+
+			content_length = 0;
+			while (*value >= '0' && *value <= '9') {
+				ulong digit = *value - '0';
+
+				if (content_length > (~0UL - digit) / 10)
+					return -EOVERFLOW;
+				content_length = content_length * 10 + digit;
+				value++;
+			}
+			while (*value == ' ' || *value == '\t')
+				value++;
+			if (*value)
+				return -EINVAL;
+		} else if (!strncasecmp(line, "Content-Type:", 13)) {
+			if (content_type_seen)
+				return -EINVAL;
+			content_type_seen = true;
+			value = line + 13;
+			while (*value == ' ' || *value == '\t')
+				value++;
+			value_end = value + strlen(value);
+			while (value_end > value &&
+			       (value_end[-1] == ' ' || value_end[-1] == '\t'))
+				*--value_end = '\0';
+			if (strcasecmp(value, "application/octet-stream"))
+				return -EOPNOTSUPP;
+		} else if (!strncasecmp(line, "Transfer-Encoding:", 18)) {
+			return -EPROTO;
+		}
+
+		line = line_end + 2;
+	}
+
+	connection->content_length = content_length;
+	if (connection->kind == RECOVERY_HTTP_REQUEST_UPLOAD) {
+		if (!content_length_seen || !content_length)
+			return -EINVAL;
+		if (!content_type_seen)
+			return -EOPNOTSUPP;
+		if (content_length > recovery_http.request.max_size ||
+		    content_length > recovery_http.request.load_limit -
+				     recovery_http.request.load_addr)
+			return -EFBIG;
+	} else if (content_length_seen && content_length) {
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int recovery_http_store_body(ulong offset, const void *data, ulong size)
+{
+	const struct recovery_http_request *request = &recovery_http.request;
+	struct recovery_http_connection *connection = &recovery_http.connection;
+	ulong address;
+	void *mapped;
+
+	if (offset > connection->content_length ||
+	    size > connection->content_length - offset)
+		return -EFBIG;
+	if (offset > request->max_size || size > request->max_size - offset)
+		return -EFBIG;
+
+	address = request->load_addr + offset;
+	if (address < request->load_addr || address > request->load_limit ||
+	    size > request->load_limit - address)
+		return -EOVERFLOW;
+
+	mapped = map_sysmem(address, size);
+	memcpy(mapped, data, size);
+	unmap_sysmem(mapped);
+
+	return 0;
+}
+
+static int recovery_http_queue_response(struct recovery_http_connection *connection,
+					const char *status, const char *content_type,
+		const char *body, bool boot_after_close)
+{
+	size_t body_length = strlen(body);
+	int length;
+
+	if (body_length >= sizeof(connection->response_body))
+		return -ENOSPC;
+	memmove(connection->response_body, body, body_length + 1);
+	connection->response_body_length = body_length;
+
+	length = snprintf(connection->response_header,
+			  sizeof(connection->response_header),
+			  "HTTP/1.1 %s\r\n"
+			  "Content-Type: %s\r\n"
+			  "Content-Length: %u\r\n"
+			  "Connection: close\r\n"
+			  "\r\n",
+			  status, content_type,
+			  connection->response_body_length);
+	if (length < 0 || length >= sizeof(connection->response_header))
+		return -ENOSPC;
+
+	connection->response_header_length = length;
+	connection->response_ready = true;
+	connection->response_acked = false;
+	connection->boot_after_close = boot_after_close;
+
+	return 0;
+}
+
+static int recovery_http_rx(struct tcp_stream *tcp, u32 rx_offs,
+			    void *data, int length)
+{
+	struct recovery_http_connection *connection = tcp->priv;
+	u64 stream_end;
+	u32 body_start;
+	u32 data_offset;
+	u32 body_offset;
+	u32 body_length;
+
+	if (length <= 0)
+		return length;
+	if (connection->response_ready)
+		return length;
+
+	stream_end = (u64)rx_offs + length;
+	if (!connection->header_parsed) {
+		if (stream_end > RECOVERY_HTTP_HEADER_SIZE)
+			return 0;
+		memcpy(connection->header + rx_offs, data, length);
+		return length;
+	}
+
+	if (connection->kind != RECOVERY_HTTP_REQUEST_UPLOAD)
+		return -EPROTO;
+
+	body_start = connection->header_length;
+	if (stream_end <= body_start)
+		return length;
+
+	data_offset = rx_offs < body_start ? body_start - rx_offs : 0;
+	body_offset = rx_offs + data_offset - body_start;
+	body_length = length - data_offset;
+	if (recovery_http_store_body(body_offset,
+				     (const char *)data + data_offset,
+				     body_length))
+		return -EFBIG;
+
+	return length;
+}
+
+static int recovery_http_tx(struct tcp_stream *tcp, u32 tx_offs,
+			    void *data, int max_length)
+{
+	struct recovery_http_connection *connection = tcp->priv;
+	u32 total_length;
+	u32 copied = 0;
+	u32 length;
+
+	if (!connection->response_ready || max_length <= 0)
+		return 0;
+
+	total_length = connection->response_header_length +
+		       connection->response_body_length;
+	if (tx_offs >= total_length)
+		return 0;
+
+	if (tx_offs < connection->response_header_length) {
+		length = min_t(u32, max_length,
+			       connection->response_header_length - tx_offs);
+		memcpy(data, connection->response_header + tx_offs, length);
+		copied += length;
+		tx_offs += length;
+		max_length -= length;
+	}
+
+	if (max_length && tx_offs >= connection->response_header_length) {
+		u32 body_offset = tx_offs - connection->response_header_length;
+
+		length = min_t(u32, max_length,
+			       connection->response_body_length - body_offset);
+		memcpy((char *)data + copied,
+		       connection->response_body + body_offset, length);
+		copied += length;
+	}
+
+	return copied;
+}
+
+static void recovery_http_on_rcv_nxt_update(struct tcp_stream *tcp,
+					    u32 received)
+{
+	struct recovery_http_connection *connection = tcp->priv;
+	const char *status;
+	const char *status_class;
+	const char *message;
+	char page_status[96];
+	int header_end;
+	int length;
+	int ret;
+	ulong body_received;
+
+	if (connection->response_ready)
+		return;
+
+	if (!connection->header_parsed) {
+		if (received > RECOVERY_HTTP_HEADER_SIZE) {
+			tcp_stream_reset(tcp);
+			return;
+		}
+		connection->header[received] = '\0';
+		header_end = recovery_http_find_header_end(connection->header,
+							   received);
+		if (header_end < 0) {
+			if (received == RECOVERY_HTTP_HEADER_SIZE) {
+				connection->header_parsed = true;
+				ret = recovery_http_queue_response(connection,
+								   "431 Request Header Fields Too Large",
+					"text/plain",
+					"Request header is too large\n", false);
+				if (ret)
+					tcp_stream_reset(tcp);
+			}
+			return;
+		}
+
+		connection->header_length = header_end;
+		connection->header_parsed = true;
+		ret = recovery_http_parse_request(connection);
+		if (ret) {
+			status = "400 Bad Request";
+			message = "Invalid request\n";
+			if (ret == -ENOENT) {
+				status = "404 Not Found";
+				message = "Not found\n";
+			} else if (ret == -ENOSYS) {
+				status = "405 Method Not Allowed";
+				message = "Method not allowed\n";
+			} else if (ret == -EFBIG || ret == -EOVERFLOW) {
+				status = "413 Content Too Large";
+				message = "Recovery image is too large\n";
+			} else if (ret == -EOPNOTSUPP) {
+				status = "415 Unsupported Media Type";
+				message = "Use application/octet-stream\n";
+			}
+
+			ret = recovery_http_queue_response(connection, status,
+							   "text/plain", message,
+							   false);
+			if (ret)
+				tcp_stream_reset(tcp);
+			return;
+		}
+
+		if (connection->kind == RECOVERY_HTTP_REQUEST_PAGE) {
+			if (recovery_http.upload_valid) {
+				ret = snprintf(page_status, sizeof(page_status),
+					       "Recovery image ready: %lu bytes.",
+					       recovery_http.uploaded_size);
+				if (ret < 0 || ret >= (int)sizeof(page_status)) {
+					tcp_stream_reset(tcp);
+					return;
+				}
+				status_class = "ready";
+				status = "";
+			} else {
+				message = recovery_http.request.initial_status;
+				if (!message || !*message) {
+					message = "No complete recovery image has been uploaded.";
+					status_class = "waiting";
+				} else {
+					status_class = "error";
+				}
+
+				strlcpy(page_status, message, sizeof(page_status));
+				status = "disabled";
+			}
+
+			length = snprintf(connection->response_body,
+					  sizeof(connection->response_body),
+					  recovery_http_page, status_class,
+					  page_status, status);
+			if (length < 0 ||
+			    length >= sizeof(connection->response_body)) {
+				tcp_stream_reset(tcp);
+				return;
+			}
+			ret = recovery_http_queue_response(connection, "200 OK",
+							   "text/html; charset=utf-8",
+							   connection->response_body,
+							   false);
+			if (ret)
+				tcp_stream_reset(tcp);
+			return;
+		}
+
+		if (connection->kind == RECOVERY_HTTP_REQUEST_BOOT) {
+			if (!recovery_http.upload_valid) {
+				ret = recovery_http_queue_response(connection,
+								   "409 Conflict", "text/plain",
+					"No complete recovery image is available\n",
+					false);
+				if (ret)
+					tcp_stream_reset(tcp);
+				return;
+			}
+
+			if (recovery_http.request.set_receiving)
+				recovery_http.request.set_receiving(true);
+			ret = recovery_http_queue_response(connection, "200 OK",
+							   "text/plain",
+				"Booting recovery image\n", true);
+			if (ret) {
+				if (recovery_http.request.set_receiving)
+					recovery_http.request.set_receiving(false);
+				tcp_stream_reset(tcp);
+			}
+			return;
+		}
+
+		recovery_http.upload_valid = false;
+		recovery_http.uploaded_size = 0;
+		connection->receiving = true;
+		if (recovery_http.request.set_receiving)
+			recovery_http.request.set_receiving(true);
+
+		body_received = received - connection->header_length;
+		if (body_received &&
+		    recovery_http_store_body(0,
+					     connection->header + connection->header_length,
+			body_received)) {
+			tcp_stream_reset(tcp);
+			return;
+		}
+	}
+
+	if (connection->kind != RECOVERY_HTTP_REQUEST_UPLOAD)
+		return;
+
+	body_received = received - connection->header_length;
+	if (body_received != connection->content_length)
+		return;
+
+	connection->receiving = false;
+	recovery_http.uploaded_size = connection->content_length;
+	recovery_http.upload_valid = true;
+	if (recovery_http.request.set_receiving)
+		recovery_http.request.set_receiving(false);
+
+	length = snprintf(connection->response_body,
+			  sizeof(connection->response_body),
+			  "Received %lu bytes\n", recovery_http.uploaded_size);
+	if (length < 0 || length >= sizeof(connection->response_body)) {
+		tcp_stream_reset(tcp);
+		return;
+	}
+
+	ret = recovery_http_queue_response(connection, "200 OK", "text/plain",
+					   connection->response_body, false);
+	if (ret)
+		tcp_stream_reset(tcp);
+}
+
+static void recovery_http_on_snd_una_update(struct tcp_stream *tcp,
+					    u32 acknowledged)
+{
+	struct recovery_http_connection *connection = tcp->priv;
+	u32 response_length;
+
+	response_length = connection->response_header_length +
+			  connection->response_body_length;
+	if (!connection->response_ready || acknowledged < response_length)
+		return;
+
+	connection->response_acked = true;
+	tcp_stream_close(tcp);
+}
+
+static void recovery_http_on_closed(struct tcp_stream *tcp)
+{
+	struct recovery_http_connection *connection = tcp->priv;
+
+	if (connection->receiving) {
+		recovery_http.upload_valid = false;
+		recovery_http.uploaded_size = 0;
+		if (recovery_http.request.set_receiving)
+			recovery_http.request.set_receiving(false);
+	}
+
+	if (connection->boot_after_close) {
+		if (connection->response_acked &&
+		    tcp_stream_get_status(tcp) == TCP_ERR_OK &&
+		    recovery_http.upload_valid) {
+			recovery_http.result->received_size =
+				recovery_http.uploaded_size;
+			net_set_state(NETLOOP_SUCCESS);
+		} else if (recovery_http.request.set_receiving) {
+			recovery_http.request.set_receiving(false);
+		}
+	}
+
+	memset(connection, 0, sizeof(*connection));
+}
+
+static int recovery_http_on_create(struct tcp_stream *tcp)
+{
+	struct recovery_http_connection *connection;
+
+	if (tcp->lport != RECOVERY_HTTP_PORT)
+		return 0;
+
+	connection = &recovery_http.connection;
+	memset(connection, 0, sizeof(*connection));
+	tcp->priv = connection;
+	tcp->rx = recovery_http_rx;
+	tcp->tx = recovery_http_tx;
+	tcp->on_rcv_nxt_update = recovery_http_on_rcv_nxt_update;
+	tcp->on_snd_una_update = recovery_http_on_snd_una_update;
+	tcp->on_closed = recovery_http_on_closed;
+
+	return 1;
+}
+
+void recovery_http_start_server(void)
+{
+	memset(net_server_ethaddr, 0, sizeof(net_server_ethaddr));
+	tcp_stream_set_on_create_handler(recovery_http_on_create);
+	printf("Web Rescue listening on http://%pI4/\n", &net_ip);
+}
+
+int recovery_http_run(const struct recovery_http_request *request,
+		      struct recovery_http_result *result)
+{
+	int ret;
+
+	if (result)
+		result->received_size = 0;
+	if (!request || !result || !request->load_addr || !request->max_size ||
+	    request->load_limit <= request->load_addr ||
+	    request->max_size > request->load_limit - request->load_addr)
+		return -EINVAL;
+
+	memset(&recovery_http, 0, sizeof(recovery_http));
+	recovery_http.request = *request;
+	recovery_http.result = result;
+
+	tcp_init();
+	ret = net_loop(RECOVERY_HTTP);
+	tcp_init();
+	tcp_stream_set_on_create_handler(NULL);
+
+	if (ret < 0)
+		return ret;
+	if (!result->received_size)
+		return -EIO;
+
+	return 0;
+}
