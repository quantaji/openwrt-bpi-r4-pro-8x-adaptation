diff --git a/defenvs/bananapi_bpi-r4-pro-8x_emmc_env b/defenvs/bananapi_bpi-r4-pro-8x_emmc_env
index 3768c21..fa3a242 100644
--- a/defenvs/bananapi_bpi-r4-pro-8x_emmc_env
+++ b/defenvs/bananapi_bpi-r4-pro-8x_emmc_env
@@ -1,4 +1,7 @@
 loadaddr=0x50000000
+ipaddr=192.168.1.1
+serverip=192.168.1.254
+netmask=255.255.255.0
 recovery_filename=openwrt-mediatek-filogic-bananapi_bpi-r4-pro-8x-initramfs-recovery.itb
 recovery_max_bytes=0x08000000
 recovery_max_blocks=0x40000
@@ -8,7 +11,42 @@ bootconf=config-mt7988a-bananapi-bpi-r4-pro-8x
 bootconf_emmc=mt7988a-bananapi-bpi-r4-pro-emmc
 bootconf_extra=mt7988a-bananapi-bpi-r4-pro-cn13#mt7988a-bananapi-bpi-r4-pro-cn14
 bootdelay=3
-bootcmd=echo M01 compile skeleton only: boot validation deferred
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=      [0;34m( ( ( [1;39mOpenWrt[0;34m ) ) )[0m  BPI-R4 Pro 8X  [0;36m[eMMC][0m
+bootmenu_0=Boot production system from eMMC.=run boot_production; run led_fault; run boot_recovery_auto
+bootmenu_1=Boot recovery image from local eMMC.=if run check_recovery_config; then run boot_recovery_local; run led_wait; bootmenu; else run led_terminal; fi
+bootmenu_2=Boot recovery image from USB.=run boot_recovery_usb
+bootmenu_3=Boot recovery image from TFTP.=run boot_recovery_tftp
+bootmenu_4=Boot recovery image uploaded through Web Rescue.=if run check_recovery_config; then run boot_recovery_web; else run led_terminal; fi
+bootmenu_5=Reboot.=reset
+led_idle=led blue:activity off; led red:fault off
+led_wait=led blue:activity blink 2000
+led_work=led blue:activity blink 400
+led_fault=led red:fault on
+led_terminal=led blue:activity off; led red:fault on
+preboot=run led_idle; run led_wait
+button_cmd_0_name=reset
+button_cmd_0=run boot_recovery_auto
+button_cmd_1_name=wps
+button_cmd_1=if run check_recovery_config; then \
+		run boot_recovery_web; \
+	else \
+		run led_terminal; \
+		false; \
+	fi
+bootcmd=if pstore check; then \
+		run led_fault; \
+		run boot_recovery_auto; \
+	else \
+		run boot_production; \
+		run led_fault; \
+		run boot_recovery_auto; \
+	fi
+boot_production=run led_work; \
+	run emmc_read_production && \
+	iminfo ${loadaddr} && \
+	bootm ${loadaddr}#${bootconf}#${bootconf_emmc}#${bootconf_extra}
 boot_recovery_local=if run read_recovery; then \
 		if run boot_loaded_recovery; then \
 			true; \
@@ -19,6 +57,25 @@ boot_recovery_local=if run read_recovery; then \
 	else \
 		false; \
 	fi
+boot_recovery_web=run led_wait; \
+	echo; \
+	echo "[1;36mWeb Rescue[0m"; \
+	echo; \
+	echo "  Interface: LAN5"; \
+	echo; \
+	echo "[0;33mWaiting for recovery image upload...[0m"; \
+	while true; do \
+		if recovery_web; then \
+			run led_work; \
+			if run boot_loaded_recovery; then \
+				true; \
+			else \
+				setenv recovery_web_status Recovery image was rejected by U-Boot validation.; \
+				run led_fault; \
+			fi; \
+		fi; \
+		run led_wait; \
+	done
 check_recovery_config=env exists loadaddr && \
 	env exists recovery_filename && \
 	env exists recovery_max_bytes && \
@@ -36,6 +93,104 @@ probe_recovery_local=mmc dev 0 && \
 	part start mmc 0 ${part_recovery} recovery_probe_addr && \
 	part size mmc 0 ${part_recovery} recovery_probe_size && \
 	itest.q ${recovery_probe_size} -ge 0x100
+boot_recovery_usb_candidates=while true; do \
+		run led_work; \
+		if recovery_usb load; then \
+			if run boot_loaded_recovery; then \
+				true; \
+			else \
+				run led_fault; \
+			fi; \
+		fi; \
+		run led_wait; \
+		if recovery_usb next; then \
+			true; \
+		else \
+			break; \
+		fi; \
+	done
+boot_recovery_usb=if run check_recovery_config; then \
+		echo; \
+		echo "[1;36mUSB Recovery[0m"; \
+		echo; \
+		echo "  Image: ${recovery_filename}"; \
+		echo "  Location: root directory"; \
+		echo "  Filesystems: FAT or ext"; \
+		echo; \
+		echo "[0;33mWaiting for recovery image...[0m"; \
+		while true; do \
+			run led_wait; \
+			if recovery_usb probe; then \
+				run boot_recovery_usb_candidates; \
+			fi; \
+		done; \
+	else \
+		run led_terminal; \
+		false; \
+	fi
+boot_recovery_tftp=if run check_recovery_config; then \
+		echo; \
+		echo "[1;36mTFTP Recovery[0m"; \
+		echo; \
+		echo "  Interface: LAN5"; \
+		echo "  Device address: ${ipaddr}"; \
+		echo "  Server address: ${serverip}"; \
+		echo "  Image: ${recovery_filename}"; \
+		echo; \
+		echo "[0;33mWaiting for TFTP server...[0m"; \
+		while true; do \
+			run led_wait; \
+			if recovery_tftp probe; then \
+				run led_work; \
+				if recovery_tftp load; then \
+					if run boot_loaded_recovery; then \
+						true; \
+					else \
+						run led_fault; \
+					fi; \
+				fi; \
+			fi; \
+		done; \
+	else \
+		run led_terminal; \
+		false; \
+	fi
+boot_recovery_auto=if run check_recovery_config; then \
+		while true; do \
+			setenv recovery_usb_ready; \
+			setenv recovery_tftp_ready; \
+			setenv recovery_local_ready; \
+			run led_wait; \
+			if recovery_usb probe; then \
+				setenv recovery_usb_ready 1; \
+			fi; \
+			if recovery_tftp probe; then \
+				setenv recovery_tftp_ready 1; \
+			fi; \
+			if run probe_recovery_local; then \
+				setenv recovery_local_ready 1; \
+			fi; \
+			if env exists recovery_usb_ready; then \
+				run boot_recovery_usb_candidates; \
+			fi; \
+			if env exists recovery_tftp_ready; then \
+				run led_work; \
+				if recovery_tftp load; then \
+					if run boot_loaded_recovery; then \
+						true; \
+					else \
+						run led_fault; \
+					fi; \
+				fi; \
+			fi; \
+			if env exists recovery_local_ready; then \
+				run boot_recovery_local; \
+			fi; \
+		done; \
+	else \
+		run led_terminal; \
+		false; \
+	fi
 boot_loaded_recovery=env exists filesize && \
 	itest.q ${filesize} -ge 0x28 && \
 	itest.q ${filesize} -le ${recovery_max_bytes} && \
