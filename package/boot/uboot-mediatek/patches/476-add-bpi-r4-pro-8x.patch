diff --git a/defenvs/bananapi_bpi-r4-pro-8x_sdmmc_env b/defenvs/bananapi_bpi-r4-pro-8x_sdmmc_env
new file mode 100644
index 0000000000000000000000000000000000000000..c129a4a0dd589c0a6bcd523cd84d0469977c311b
--- /dev/null
+++ b/defenvs/bananapi_bpi-r4-pro-8x_sdmmc_env
@@ -0,0 +1,25 @@
+bootdelay=0
+bootmenu_default=0
+bootmenu_delay=0
+bootmenu_title=      OpenWrt [SD card]
+bootmenu_0=Initialize environment.=run _firstboot
+bootmenu_0d=Run default boot command.=run bootcmd
+bootmenu_1=Boot production system from SD card.=run boot_production
+bootmenu_2=Boot recovery system from SD card.=run boot_recovery
+loadaddr=0x50000000
+bootargs=console=ttyS0,115200n1 pci=pcie_bus_perf root=/dev/fit0 rootwait
+bootconf=config-mt7988a-bananapi-bpi-r4-pro-8x
+bootconf_sd=mt7988a-bananapi-bpi-r4-pro-sd
+bootconf_extra=mt7988a-bananapi-bpi-r4-pro-cn13#mt7988a-bananapi-bpi-r4-pro-cn14
+bootcmd=if pstore check ; then run boot_recovery ; else run boot_sdmmc ; fi
+boot_sdmmc=run boot_production ; run boot_recovery
+boot_production=run sdmmc_read_production && iminfo $loadaddr && bootm $loadaddr#$bootconf#$bootconf_sd#$bootconf_extra
+boot_recovery=run sdmmc_read_recovery && bootm $loadaddr#$bootconf#$bootconf_sd#$bootconf_extra
+mmc_read_vol=mmc read $loadaddr $part_addr 0x100 && imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc read $loadaddr 0x$part_addr 0x$image_size && setexpr filesize $image_size * 0x200
+part_default=production
+part_recovery=recovery
+sdmmc_read_production=part start mmc 0 $part_default part_addr && part size mmc 0 $part_default part_size && run mmc_read_vol
+sdmmc_read_recovery=part start mmc 0 $part_recovery part_addr && part size mmc 0 $part_recovery part_size && run mmc_read_vol
+_init_env=setenv _init_env ; saveenv ; saveenv
+_firstboot=setenv _firstboot ; run _switch_to_menu ; run _init_env ; run bootcmd
+_switch_to_menu=setenv _switch_to_menu ; setenv bootdelay 3 ; setenv bootmenu_delay 3 ; setenv bootmenu_0 $bootmenu_0d ; setenv bootmenu_0d
