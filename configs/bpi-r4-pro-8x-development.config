# BPI-R4 Pro 8X development build configuration
#
# This file records human-selected build intent. Copy it to .config and run
# make defconfig to let the current OpenWrt main resolve defaults and
# dependencies. Do not copy generated dependency selections back into here.

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4-pro-8x=y

# Cross-stage development and runtime-diagnostic tools.
# nano-full is provided by the official OpenWrt packages feed.
# CONFIG_PACKAGE_nano is not set
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_nstat=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_devlink=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_iputils-tracepath=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_KERNEL_DYNAMIC_DEBUG=y

# Kernel performance, ftrace, kprobe and eBPF diagnostics.
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_PACKAGE_bpftool-full=y
CONFIG_PACKAGE_perf=y
CONFIG_PACKAGE_trace-cmd=y
CONFIG_PACKAGE_trace-cmd-extra=y
CONFIG_PACKAGE_ply=y

# M02 SD FIT/rootfs runtime tools.
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y

CONFIG_PACKAGE_kmod-i2c-mux-pca954x=y
CONFIG_PACKAGE_kmod-gpio-pca953x=y
CONFIG_PACKAGE_kmod-eeprom-at24=y
CONFIG_PACKAGE_kmod-rtc-pcf8563=y

CONFIG_PACKAGE_kmod-dsa-mxl862xx=y
CONFIG_PACKAGE_kmod-phy-aeonsemi-as21xxx=y

CONFIG_PACKAGE_kmod-sfp=y

# M06/M07 wireless.
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y

# M08 hardware acceleration.
CONFIG_PACKAGE_mt7988-wo-firmware=y

CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

# M09 board expansion, USB and NVMe.
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_nvme-cli=y

# Daily-use USB storage and filesystems.
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fuse=y

# Daily-use netfilter, traffic accounting and compatibility helpers.
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-netdev=y

# VPN and transparent-proxy kernel support.
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-dummy=y

# SQM and advanced traffic control.
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-ctinfo=y

# Containers and virtual network interfaces.
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-ipvlan=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-physdev=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-nf-ipvs=y

# USB cellular modems and legacy WAN compatibility.
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-l2tp-ip=y
CONFIG_PACKAGE_kmod-l2tp-eth=y
CONFIG_PACKAGE_kmod-pppol2tp=y

# NAS clients, NFS and encrypted or image-backed storage.
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_kmod-fs-nfs-v3=y
CONFIG_PACKAGE_kmod-fs-nfs-v4=y
CONFIG_PACKAGE_kmod-fs-nfsd=y
CONFIG_PACKAGE_kmod-dm=y
CONFIG_PACKAGE_kmod-loop=y

# Common USB peripherals and adapters.
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-sound-core=y
CONFIG_PACKAGE_kmod-usb-audio=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y

# IPsec and overlay tunnels.
CONFIG_PACKAGE_kmod-ipsec=y
CONFIG_PACKAGE_kmod-ipsec4=y
CONFIG_PACKAGE_kmod-ipsec6=y
CONFIG_PACKAGE_kmod-xfrm-interface=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-gre6=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-geneve=y

# Runtime diagnostics and aggregate network LED trigger.
CONFIG_PACKAGE_kmod-netconsole=y
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_PACKAGE_kmod-ledtrig-network=y

# M10 storage management, recovery and local network-boot services.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_atftp=y
CONFIG_PACKAGE_uhttpd=y

# Daily-use LuCI interface with HTTPS and Simplified Chinese translations.
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# Daily-use VPN services and their LuCI integration.
CONFIG_PACKAGE_openconnect=y
CONFIG_OPENCONNECT_OPENSSL=y
# CONFIG_OPENCONNECT_GNUTLS is not set
CONFIG_PACKAGE_luci-proto-openconnect=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# Dynamic DNS and migrated daily-use utilities.
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_tmux=y

# Replace the default compact service variants with the approved full builds.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
