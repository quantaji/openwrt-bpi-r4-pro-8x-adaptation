From: Codex <codex@openai.com>
Date: Sun, 16 Aug 2026 00:00:00 -0700
Subject: [PATCH] DO NOT SUBMIT: net: dsa: mxl862xx: expose XPCS state

Reuse the driver's existing XPCS_GET_STATE request and append its live
firmware result to the ethtool SerDes statistics for ports 9 and 13.
Also record the completed XPCS PCS_CONFIG and PCS_LINK_UP calls, including
the firmware interface, negotiation mode, pause policy, resolved speed,
duplex, and returned error.  This shows whether 10GBase-R configuration and
the external PHY's resolved copper speed reached the MxL firmware.

Keep the existing EQ fields and firmware-version gate unchanged.  Count and
validity fields distinguish calls that have not happened and unavailable
XPCS reads from real zero-valued results.  Apart from a rate-limited warning
when PCS_LINK_UP fails, the diagnostic does not alter command decisions.

The XPCS APIs were introduced by Daniel Golle's upstream MxL862xx driver
work.  This diagnostic exposure and command recording are temporary test
code written by Codex.

Signed-off-by: Codex <codex@openai.com>
---
diff --git a/drivers/net/dsa/mxl862xx/mxl862xx-phylink.c b/drivers/net/dsa/mxl862xx/mxl862xx-phylink.c
index 0bccef8..488ac78 100644
--- a/drivers/net/dsa/mxl862xx/mxl862xx-phylink.c
+++ b/drivers/net/dsa/mxl862xx/mxl862xx-phylink.c
@@ -303,7 +303,7 @@ static int mxl862xx_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 	struct mxl862xx_pcs *mpcs = pcs_to_mxl862xx_pcs(pcs);
 	struct mxl862xx_priv *priv = mpcs->priv;
 	struct mxl862xx_xpcs_pcs_cfg cfg = {};
-	int if_mode, lane, ret, adv;
+	int if_mode, neg, lane, ret, adv;
 
 	if_mode = mxl862xx_xpcs_if_mode(interface);
 	if (if_mode < 0) {
@@ -324,6 +324,7 @@ static int mxl862xx_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 	 */
 	lane = (interface == PHY_INTERFACE_MODE_10G_QXGMII) ?
 	       MXL862XX_XPCS_USX_QUAD : MXL862XX_XPCS_USX_SINGLE;
+	neg = mxl862xx_xpcs_neg_mode(neg_mode);
 
 	cfg.mode = cpu_to_le16(FIELD_PREP(MXL862XX_XPCS_CFG_PORT_ID,
 					  mpcs->serdes_id) |
@@ -331,8 +332,7 @@ static int mxl862xx_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 					  mpcs->slot) |
 			       FIELD_PREP(MXL862XX_XPCS_CFG_USX_LANE_MODE, lane) |
 			       FIELD_PREP(MXL862XX_XPCS_CFG_INTERFACE, if_mode) |
-			       FIELD_PREP(MXL862XX_XPCS_CFG_NEG_MODE,
-					  mxl862xx_xpcs_neg_mode(neg_mode)) |
+			       FIELD_PREP(MXL862XX_XPCS_CFG_NEG_MODE, neg) |
 			       FIELD_PREP(MXL862XX_XPCS_CFG_ROLE,
 					  MXL862XX_XPCS_ROLE_MAC) |
 			       FIELD_PREP(MXL862XX_XPCS_CFG_PERMIT_PAUSE,
@@ -345,16 +345,50 @@ static int mxl862xx_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 			cfg.advertising.cl37 = cpu_to_le16(adv);
 	}
 
+	WRITE_ONCE(mpcs->diag_cfg_interface, if_mode);
+	WRITE_ONCE(mpcs->diag_cfg_neg_mode, neg);
+	WRITE_ONCE(mpcs->diag_cfg_permit_pause, permit_pause_to_mac);
+
 	ret = MXL862XX_API_READ(priv, MXL862XX_XPCS_PCS_CONFIG, cfg);
-	if (ret)
-		return ret;
+	if (!ret) {
+		ret = (s16)le16_to_cpu(cfg.result);
+		if (ret < 0) {
+			ret = mxl862xx_xpcs_errno(ret);
+		} else {
+			mpcs->interface = interface;
+			ret = ret > 0 ? 1 : 0;
+		}
+	}
+
+	WRITE_ONCE(mpcs->diag_cfg_result, ret);
+	WRITE_ONCE(mpcs->diag_cfg_calls,
+		   READ_ONCE(mpcs->diag_cfg_calls) + 1);
+	return ret;
+}
+
+static int mxl862xx_xpcs_read_state(struct mxl862xx_pcs *mpcs,
+				    phy_interface_t interface,
+				    struct mxl862xx_xpcs_pcs_state *st)
+{
+	struct mxl862xx_priv *priv = mpcs->priv;
+	int if_mode, lane;
+
+	if_mode = mxl862xx_xpcs_if_mode(interface);
+	if (if_mode < 0)
+		return if_mode;
 
-	ret = (s16)le16_to_cpu(cfg.result);
-	if (ret < 0)
-		return mxl862xx_xpcs_errno(ret);
+	lane = (interface == PHY_INTERFACE_MODE_10G_QXGMII) ?
+	       MXL862XX_XPCS_USX_QUAD : MXL862XX_XPCS_USX_SINGLE;
 
-	mpcs->interface = interface;
-	return ret > 0 ? 1 : 0;
+	memset(st, 0, sizeof(*st));
+	st->mode = cpu_to_le32(FIELD_PREP(MXL862XX_XPCS_ST_PORT_ID,
+					  mpcs->serdes_id) |
+			       FIELD_PREP(MXL862XX_XPCS_ST_INTERFACE, if_mode) |
+			       FIELD_PREP(MXL862XX_XPCS_ST_USX_SUBPORT,
+					  mpcs->slot) |
+			       FIELD_PREP(MXL862XX_XPCS_ST_USX_LANE_MODE, lane));
+
+	return MXL862XX_API_READ(priv, MXL862XX_XPCS_PCS_GET_STATE, *st);
 }
 
 static void mxl862xx_pcs_get_state(struct phylink_pcs *pcs,
@@ -362,29 +396,12 @@ static void mxl862xx_pcs_get_state(struct phylink_pcs *pcs,
 				   struct phylink_link_state *state)
 {
 	struct mxl862xx_pcs *mpcs = pcs_to_mxl862xx_pcs(pcs);
-	struct mxl862xx_priv *priv = mpcs->priv;
-	struct mxl862xx_xpcs_pcs_state st = {};
-	int if_mode, lane, ret;
+	struct mxl862xx_xpcs_pcs_state st;
 	u32 mode;
 	u16 bmsr;
+	int ret;
 
-	if_mode = mxl862xx_xpcs_if_mode(state->interface);
-	if (if_mode < 0) {
-		state->link = false;
-		return;
-	}
-
-	lane = (state->interface == PHY_INTERFACE_MODE_10G_QXGMII) ?
-	       MXL862XX_XPCS_USX_QUAD : MXL862XX_XPCS_USX_SINGLE;
-
-	st.mode = cpu_to_le32(FIELD_PREP(MXL862XX_XPCS_ST_PORT_ID,
-					 mpcs->serdes_id) |
-			      FIELD_PREP(MXL862XX_XPCS_ST_INTERFACE, if_mode) |
-			      FIELD_PREP(MXL862XX_XPCS_ST_USX_SUBPORT,
-					 mpcs->slot) |
-			      FIELD_PREP(MXL862XX_XPCS_ST_USX_LANE_MODE, lane));
-
-	ret = MXL862XX_API_READ(priv, MXL862XX_XPCS_PCS_GET_STATE, st);
+	ret = mxl862xx_xpcs_read_state(mpcs, state->interface, &st);
 	if (ret) {
 		state->link = false;
 		return;
@@ -458,7 +475,7 @@ static void mxl862xx_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
 	struct mxl862xx_pcs *mpcs = pcs_to_mxl862xx_pcs(pcs);
 	struct mxl862xx_xpcs_pcs_link_up lu = {};
 	struct mxl862xx_priv *priv = mpcs->priv;
-	int if_mode, lane, dup;
+	int if_mode, lane, dup, ret;
 
 	/* With inband-AN enabled (role=MAC), the XPCS auto-resolves
 	 * speed/duplex from the partner's AN word and the firmware
@@ -486,7 +503,19 @@ static void mxl862xx_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
 			      FIELD_PREP(MXL862XX_XPCS_LU_DUPLEX, dup));
 	lu.speed = cpu_to_le16(speed);
 
-	MXL862XX_API_WRITE(priv, MXL862XX_XPCS_PCS_LINK_UP, lu);
+	WRITE_ONCE(mpcs->diag_link_up_interface, if_mode);
+	WRITE_ONCE(mpcs->diag_link_up_speed, speed);
+	WRITE_ONCE(mpcs->diag_link_up_duplex, duplex);
+
+	ret = MXL862XX_API_WRITE(priv, MXL862XX_XPCS_PCS_LINK_UP, lu);
+	WRITE_ONCE(mpcs->diag_link_up_result, ret);
+	WRITE_ONCE(mpcs->diag_link_up_calls,
+		   READ_ONCE(mpcs->diag_link_up_calls) + 1);
+	if (ret)
+		dev_warn_ratelimited(priv->ds->dev,
+			"port %d: XPCS link-up failed for %s at %dMbps: %d\n",
+			MXL862XX_PCS_PORT(mpcs), phy_modes(interface), speed,
+			ret);
 }
 
 static unsigned int mxl862xx_pcs_inband_caps(struct phylink_pcs *pcs,
@@ -597,6 +626,34 @@ const struct phylink_mac_ops mxl862xx_phylink_mac_ops = {
 
 /* --- SerDes ethtool statistics --- */
 
+#define MXL862XX_SERDES_EQ_STATS	15
