+	xpcs_data[MXL862XX_XPCS_STAT_AN_COMPLETE] =
+		FIELD_GET(MXL862XX_XPCS_ST_AN_COMPLETE, mode);
+	xpcs_data[MXL862XX_XPCS_STAT_PCS_FAULT] =
+		FIELD_GET(MXL862XX_XPCS_ST_PCS_FAULT, mode);
+	xpcs_data[MXL862XX_XPCS_STAT_SPEED] = le16_to_cpu(st.speed);
+	xpcs_data[MXL862XX_XPCS_STAT_DUPLEX] =
+		FIELD_GET(MXL862XX_XPCS_ST_DUPLEX, mode);
+	xpcs_data[MXL862XX_XPCS_STAT_PAUSE] =
+		FIELD_GET(MXL862XX_XPCS_ST_PAUSE, mode);
+	xpcs_data[MXL862XX_XPCS_STAT_LPA] = le16_to_cpu(st.lpa.usx);
+	xpcs_data[MXL862XX_XPCS_STAT_LP_EEE] =
+		FIELD_GET(MXL862XX_XPCS_ST_LP_EEE_CAP, mode);
+	xpcs_data[MXL862XX_XPCS_STAT_LP_EEE_CS] =
+		FIELD_GET(MXL862XX_XPCS_ST_LP_EEE_CS_CAP, mode);
 }
diff --git a/drivers/net/dsa/mxl862xx/mxl862xx.h b/drivers/net/dsa/mxl862xx/mxl862xx.h
index 9d8113f..805724c 100644
--- a/drivers/net/dsa/mxl862xx/mxl862xx.h
+++ b/drivers/net/dsa/mxl862xx/mxl862xx.h
@@ -310,6 +310,17 @@ struct mxl862xx_pcs {
 	int serdes_id;
 	int slot;
 	phy_interface_t interface;
+	/* Temporary command diagnostics, exposed through ethtool stats. */
