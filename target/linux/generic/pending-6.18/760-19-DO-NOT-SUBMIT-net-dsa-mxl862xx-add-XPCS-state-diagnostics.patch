 	"serdes_tx_pre",
@@ -613,8 +670,33 @@ static const char mxl862xx_serdes_stats[][ETH_GSTRING_LEN] = {
 	"serdes_rx_dfe_bypass",
 	"serdes_rx_adapt_mode",
 	"serdes_rx_adapt_sel",
+	"xpcs_state_valid",
