+	MXL862XX_XPCS_STAT_AN_COMPLETE,
+	MXL862XX_XPCS_STAT_PCS_FAULT,
+	MXL862XX_XPCS_STAT_SPEED,
+	MXL862XX_XPCS_STAT_DUPLEX,
+	MXL862XX_XPCS_STAT_PAUSE,
+	MXL862XX_XPCS_STAT_LPA,
+	MXL862XX_XPCS_STAT_LP_EEE,
+	MXL862XX_XPCS_STAT_LP_EEE_CS,
+	MXL862XX_XPCS_STAT_CFG_CALLS,
+	MXL862XX_XPCS_STAT_CFG_INTERFACE,
+	MXL862XX_XPCS_STAT_CFG_NEG_MODE,
+	MXL862XX_XPCS_STAT_CFG_PERMIT_PAUSE,
+	MXL862XX_XPCS_STAT_CFG_CHANGED,
