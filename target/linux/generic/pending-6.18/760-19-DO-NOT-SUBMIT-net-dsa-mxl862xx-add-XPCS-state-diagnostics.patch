+	u32 cfg_calls, link_up_calls;
+	u32 mode;
+	int i, result, ret;
 
 	if (!mxl862xx_port_has_serdes_stats(ds, port))
 		return;
 
-	ret = MXL862XX_API_READ(ds->priv, MXL862XX_XPCS_EQ_GET, eq);
+	for (i = 0; i < ARRAY_SIZE(mxl862xx_serdes_stats); i++)
+		data[i] = U64_MAX;
