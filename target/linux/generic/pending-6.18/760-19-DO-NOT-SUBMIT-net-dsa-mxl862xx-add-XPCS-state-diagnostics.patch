-	*data++ = mxl862xx_eq_effective(&eq.rx.att_lvl);
-	*data++ = mxl862xx_eq_effective(&eq.rx.vga1_gain);
-	*data++ = mxl862xx_eq_effective(&eq.rx.vga2_gain);
