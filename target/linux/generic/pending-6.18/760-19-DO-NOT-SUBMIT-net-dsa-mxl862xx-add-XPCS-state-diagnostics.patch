+		xpcs_data[MXL862XX_XPCS_STAT_CFG_PERMIT_PAUSE] =
+			READ_ONCE(mpcs->diag_cfg_permit_pause);
+		xpcs_data[MXL862XX_XPCS_STAT_CFG_CHANGED] = result > 0;
+		xpcs_data[MXL862XX_XPCS_STAT_CFG_ERRNO] =
+			result < 0 ? -result : 0;
+	}
+
+	link_up_calls = READ_ONCE(mpcs->diag_link_up_calls);
+	xpcs_data[MXL862XX_XPCS_STAT_LINK_UP_CALLS] = link_up_calls;
+	if (link_up_calls) {
+		result = READ_ONCE(mpcs->diag_link_up_result);
+		xpcs_data[MXL862XX_XPCS_STAT_LINK_UP_INTERFACE] =
+			READ_ONCE(mpcs->diag_link_up_interface);
+		xpcs_data[MXL862XX_XPCS_STAT_LINK_UP_SPEED] =
+			READ_ONCE(mpcs->diag_link_up_speed);
+		xpcs_data[MXL862XX_XPCS_STAT_LINK_UP_DUPLEX] =
+			READ_ONCE(mpcs->diag_link_up_duplex);
+		xpcs_data[MXL862XX_XPCS_STAT_LINK_UP_ERRNO] =
+			result < 0 ? -result : 0;
+	}
+
+	ret = MXL862XX_API_READ(priv, MXL862XX_XPCS_EQ_GET, eq);
 	if (ret) {
 		dev_err(ds->dev,
