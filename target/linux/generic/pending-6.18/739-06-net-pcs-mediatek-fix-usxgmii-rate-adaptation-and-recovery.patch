From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 17 Aug 2026 12:00:00 -0700
Subject: [PATCH] net: pcs: mediatek: stabilize USXGMII rate adaptation and
 recovery

The MT7988 USXGMII PCS currently resets and reconfigures both the PCS and
XFI T-PHY from pcs_get_state() whenever the raw PCS receive status is down.
It repeats the same reset from pcs_link_up(). On an AS21xxx host interface
this can turn a transient receive unlock into a one-second reset loop while
the copper PHY remains linked.

Keep pcs_get_state() read-only and make pcs_config() idempotent. Program
the USXGMII rate-adaptation factor explicitly from the speed resolved by
phylink, without resetting the data path from pcs_link_up().

Move recovery to a separate delayed task. It acts only after three
consecutive USXGMII receive-unlock samples, performs at most three recovery
attempts per batch, and then waits for a cooldown. The task is cancelled
synchronously before power-off and driver removal. Register sequences and
configuration changes use separate locks so generic PHY operations are not
called while the PCS register lock is held.

Use the generic PHY calibration operation to let the XFI T-PHY reapply the
last selected interface tuning after a controlled reset. This keeps the
recovery contract inside the generic PHY API instead of adding a MediaTek
private consumer interface.

The implementation is independently reworked from the OpenWrt driver and
uses PR #24569 only as a hardware-behaviour reference.

The OpenWrt baseline is
commit c271123724fc ("generic: 6.18: fix MediaTek USXGMII driver")
by Daniel Golle <daniel@makrotopia.org>.

The PR #24569 reference is revision
092d337959187da09127f8ca5b4e2fe295dd1f27 by Sean McCully.

Link: https://github.com/openwrt/openwrt/pull/24569
Signed-off-by: Codex <codex@openai.com>
---
 drivers/net/pcs/pcs-mtk-usxgmii.c        | 278 ++++++++++++++++++----
 drivers/phy/mediatek/phy-mtk-xfi-tphy.c  |  26 ++
 2 files changed, 272 insertions(+), 32 deletions(-)

--- a/drivers/net/pcs/pcs-mtk-usxgmii.c
+++ b/drivers/net/pcs/pcs-mtk-usxgmii.c
@@ -7,6 +7,7 @@
 
 #include <linux/clk.h>
 #include <linux/io.h>
+#include <linux/jiffies.h>
 #include <linux/mfd/syscon.h>
 #include <linux/mdio.h>
 #include <linux/mutex.h>
@@ -19,6 +20,7 @@
 #include <linux/phylink.h>
 #include <linux/platform_device.h>
 #include <linux/rtnetlink.h>
+#include <linux/workqueue.h>
 
 /* USXGMII subsystem config registers */
 /* Register to control speed */
@@ -67,6 +69,11 @@
 #define RG_PCS_RX_STATUS_UPDATE			BIT(16)
 #define RG_PCS_RX_LINK_STATUS			BIT(2)
 
+#define MTK_USXGMII_RECOVERY_INTERVAL		HZ
+#define MTK_USXGMII_RX_UNLOCK_POLLS		3
+#define MTK_USXGMII_MAX_RECOVERY_ATTEMPTS	3
+#define MTK_USXGMII_RECOVERY_COOLDOWN		(30 * HZ)
+
 /* struct mtk_usxgmii_pcs - This structure holds each usxgmii PCS
  * @pcs:		Phylink PCS structure
  * @dev:		Pointer to device structure
@@ -77,6 +84,10 @@
  *			rx-polarity / tx-polarity properties
  * @interface:		Currently selected interface mode
  * @neg_mode:		Currently used phylink neg_mode
+ * @config_lock:	Serializes configuration, recovery and power changes
+ * @reg_lock:		Serializes PCS register sequences
+ * @recovery_work:	Recovers a persistently unlocked USXGMII receive path
+ * @link_speed:		Last speed programmed by pcs_link_up
  * @node:		List node
  */
 struct mtk_usxgmii_pcs {
@@ -89,6 +100,14 @@ struct mtk_usxgmii_pcs {
 	struct fwnode_handle		*fwnode;
 	phy_interface_t			interface;
 	unsigned int			neg_mode;
+	struct mutex			config_lock; /* Serializes config/recovery */
+	struct mutex			reg_lock; /* Serializes register access */
+	struct delayed_work		recovery_work;
+	bool				enabled;
+	int				link_speed;
+	unsigned int			rx_unlock_polls;
+	unsigned int			recovery_attempts;
+	unsigned long			recovery_cooldown;
 	struct list_head		node;
 };
 
@@ -112,13 +131,22 @@ static struct mtk_usxgmii_pcs *pcs_to_mtk_usxgmii_pcs(struct phylink_pcs *pcs)
 	return container_of(pcs, struct mtk_usxgmii_pcs, pcs);
 }
 
-static void mtk_usxgmii_reset(struct mtk_usxgmii_pcs *mpcs)
+static int mtk_usxgmii_reset(struct mtk_usxgmii_pcs *mpcs)
 {
-	reset_control_assert(mpcs->reset);
+	int ret;
+
+	ret = reset_control_assert(mpcs->reset);
+	if (ret)
+		return ret;
+
 	udelay(100);
-	reset_control_deassert(mpcs->reset);
+	ret = reset_control_deassert(mpcs->reset);
+	if (ret)
+		return ret;
 
 	mdelay(10);
+
+	return 0;
 }
 
 static int mtk_usxgmii_config_polarity(struct mtk_usxgmii_pcs *mpcs,
@@ -151,14 +179,12 @@ static int mtk_usxgmii_config_polarity(struct mtk_usxgmii_pcs *mpcs,
 	return 0;
 }
 
-static int mtk_usxgmii_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
-				  phy_interface_t interface,
-				  const unsigned long *advertising,
-				  bool permit_pause_to_mac)
+static int mtk_usxgmii_apply_config(struct mtk_usxgmii_pcs *mpcs,
+				    unsigned int neg_mode,
+				    phy_interface_t interface,
+				    bool calibrate)
 {
-	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
 	unsigned int an_ctrl = 0, link_timer = 0, xfi_mode = 0, adapt_mode = 0;
-	bool mode_changed = false;
 	int ret;
 
 	if (interface == PHY_INTERFACE_MODE_USXGMII) {
@@ -190,17 +216,21 @@ static int mtk_usxgmii_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode
 
 	adapt_mode |= FIELD_PREP(USXGMII_RATE_ADAPT_MODE, USXGMII_RATE_ADAPT_MODE_X1);
 
-	if (mpcs->interface != interface) {
-		mpcs->interface = interface;
-		mode_changed = true;
-	}
+	ret = phy_reset(mpcs->xfi_tphy);
+	if (ret)
+		return ret;
 
-	phy_reset(mpcs->xfi_tphy);
-	mtk_usxgmii_reset(mpcs);
+	ret = mtk_usxgmii_reset(mpcs);
+	if (ret)
+		return ret;
+
+	mutex_lock(&mpcs->reg_lock);
 
 	ret = mtk_usxgmii_config_polarity(mpcs, interface);
-	if (ret)
+	if (ret) {
+		mutex_unlock(&mpcs->reg_lock);
 		return ret;
+	}
 
 	/* Setup USXGMII AN ctrl */
 	mtk_m32(mpcs, RG_PCS_AN_CTRL0,
@@ -213,8 +243,6 @@ static int mtk_usxgmii_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode
 		USXGMII_LINK_TIMER_AN_RESTART,
 		link_timer);
 
-	mpcs->neg_mode = neg_mode;
-
 	/* Gated MAC CK */
 	mtk_m32(mpcs, RG_PHY_TOP_SPEED_CTRL1,
 		USXGMII_MAC_CK_GATED, USXGMII_MAC_CK_GATED);
@@ -244,10 +272,46 @@ static int mtk_usxgmii_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode
 	if (an_ctrl & USXGMII_AN_ENABLE)
 		mtk_m32(mpcs, RG_PHY_TOP_SPEED_CTRL1, USXGMII_IF_FORCE_EN, 0);
 
-	/* Setup PMA/PMD */
-	phy_set_mode_ext(mpcs->xfi_tphy, PHY_MODE_ETHERNET, interface);
+	mutex_unlock(&mpcs->reg_lock);
+
+	/* Generic PHY calls can sleep and take their own lock. */
+	if (calibrate)
+		ret = phy_calibrate(mpcs->xfi_tphy);
+	else
+		ret = phy_set_mode_ext(mpcs->xfi_tphy, PHY_MODE_ETHERNET,
+				       interface);
+	if (ret)
+		return ret;
+
+	mpcs->interface = interface;
+	mpcs->neg_mode = neg_mode;
 
-	return mode_changed;
+	return 0;
+}
+
+static int mtk_usxgmii_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
+				  phy_interface_t interface,
+				  const unsigned long *advertising,
+				  bool permit_pause_to_mac)
+{
+	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
+	bool mode_changed;
+	int ret = 0;
+
+	mutex_lock(&mpcs->config_lock);
+
+	mode_changed = mpcs->interface != interface;
+	if (!mode_changed && mpcs->neg_mode == neg_mode)
+		goto out;
+
+	ret = mtk_usxgmii_apply_config(mpcs, neg_mode, interface, false);
+	if (!ret)
+		mpcs->link_speed = SPEED_UNKNOWN;
+
+out:
+	mutex_unlock(&mpcs->config_lock);
+
+	return ret ?: mode_changed;
 }
 
 static void mtk_usxgmii_pcs_get_fixed_speed(struct mtk_usxgmii_pcs *mpcs,
@@ -323,6 +387,8 @@ static void mtk_usxgmii_pcs_get_state(struct phylink_pcs *pcs,
 {
 	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
 
+	mutex_lock(&mpcs->reg_lock);
+
 	/* Refresh USXGMII link status by toggling RG_PCS_AN_STATUS_UPDATE */
 	mtk_m32(mpcs, RG_PCS_RX_STATUS0, RG_PCS_RX_STATUS_UPDATE,
 		RG_PCS_RX_STATUS_UPDATE);
@@ -334,10 +400,8 @@ static void mtk_usxgmii_pcs_get_state(struct phylink_pcs *pcs,
 	state->link = FIELD_GET(RG_PCS_RX_LINK_STATUS,
 				mtk_r32(mpcs, RG_PCS_RX_STATUS0));
 
-	/* Continuously repeat re-configuration sequence until link comes up */
 	if (!state->link) {
-		mtk_usxgmii_pcs_config(pcs, mpcs->neg_mode,
-				       state->interface, NULL, false);
+		mutex_unlock(&mpcs->reg_lock);
 		return;
 	}
 
@@ -345,13 +409,52 @@ static void mtk_usxgmii_pcs_get_state(struct phylink_pcs *pcs,
 		mtk_usxgmii_pcs_get_an_state(mpcs, state);
 	else
 		mtk_usxgmii_pcs_get_fixed_speed(mpcs, state);
+
+	mutex_unlock(&mpcs->reg_lock);
 }
 
 static void mtk_usxgmii_pcs_restart_an(struct phylink_pcs *pcs)
 {
 	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
 
+	mutex_lock(&mpcs->reg_lock);
 	mtk_m32(mpcs, RG_PCS_AN_CTRL0, USXGMII_AN_RESTART, USXGMII_AN_RESTART);
+	mutex_unlock(&mpcs->reg_lock);
+}
+
+static int mtk_usxgmii_set_rate_adaptation(struct mtk_usxgmii_pcs *mpcs,
+					   int speed)
+{
+	unsigned int adapt_mode;
+
+	switch (speed) {
+	case SPEED_10000:
+		adapt_mode = USXGMII_RATE_ADAPT_MODE_X1;
+		break;
+	case SPEED_5000:
+		adapt_mode = USXGMII_RATE_ADAPT_MODE_X2;
+		break;
+	case SPEED_2500:
+		adapt_mode = USXGMII_RATE_ADAPT_MODE_X4;
+		break;
+	case SPEED_1000:
+		adapt_mode = USXGMII_RATE_ADAPT_MODE_X10;
+		break;
+	case SPEED_100:
+		adapt_mode = USXGMII_RATE_ADAPT_MODE_X100;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	mutex_lock(&mpcs->reg_lock);
+	mtk_m32(mpcs, RG_PHY_TOP_SPEED_CTRL1,
+		USXGMII_RATE_UPDATE_MODE | USXGMII_RATE_ADAPT_MODE,
+		USXGMII_RATE_UPDATE_MODE |
+		FIELD_PREP(USXGMII_RATE_ADAPT_MODE, adapt_mode));
+	mutex_unlock(&mpcs->reg_lock);
+
+	return 0;
 }
 
 static void mtk_usxgmii_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
@@ -359,32 +462,136 @@ static void mtk_usxgmii_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mo
 				    int speed, int duplex)
 {
 	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
+	int ret;
 
-	/* Reconfiguring USXGMII to ensure the quality of the RX signal
-	 * after the line side link up.
-	 */
-	mtk_usxgmii_pcs_config(pcs, neg_mode, interface, NULL, false);
-	phy_reset(mpcs->xfi_tphy);
-	phy_set_mode_ext(mpcs->xfi_tphy, PHY_MODE_ETHERNET, interface);
+	if (interface != PHY_INTERFACE_MODE_USXGMII)
+		return;
+
+	mutex_lock(&mpcs->config_lock);
+	ret = mtk_usxgmii_set_rate_adaptation(mpcs, speed);
+	if (ret) {
+		mutex_unlock(&mpcs->config_lock);
+		dev_warn(mpcs->dev, "unsupported USXGMII link speed: %d\n", speed);
+		return;
+	}
+
+	mpcs->link_speed = speed;
+	mpcs->rx_unlock_polls = 0;
+	mpcs->recovery_attempts = 0;
+	mpcs->recovery_cooldown = 0;
+	mutex_unlock(&mpcs->config_lock);
+}
+
+static bool mtk_usxgmii_pcs_rx_locked(struct mtk_usxgmii_pcs *mpcs)
+{
+	bool locked;
+
+	mutex_lock(&mpcs->reg_lock);
+	mtk_m32(mpcs, RG_PCS_RX_STATUS0, RG_PCS_RX_STATUS_UPDATE,
+		RG_PCS_RX_STATUS_UPDATE);
+	ndelay(1020);
+	mtk_m32(mpcs, RG_PCS_RX_STATUS0, RG_PCS_RX_STATUS_UPDATE, 0);
+	ndelay(1020);
+	locked = !!(mtk_r32(mpcs, RG_PCS_RX_STATUS0) &
+		    RG_PCS_RX_LINK_STATUS);
+	mutex_unlock(&mpcs->reg_lock);
+
+	return locked;
+}
+
+static void mtk_usxgmii_recovery_work(struct work_struct *work)
+{
+	struct mtk_usxgmii_pcs *mpcs =
+		container_of(to_delayed_work(work), struct mtk_usxgmii_pcs,
+			     recovery_work);
+	int ret;
+
+	if (!READ_ONCE(mpcs->enabled))
+		return;
+
+	mutex_lock(&mpcs->config_lock);
+
+	if (!mpcs->enabled || mpcs->interface != PHY_INTERFACE_MODE_USXGMII)
+		goto out;
+
+	if (mtk_usxgmii_pcs_rx_locked(mpcs)) {
+		mpcs->rx_unlock_polls = 0;
+		mpcs->recovery_attempts = 0;
+		mpcs->recovery_cooldown = 0;
+		goto out;
+	}
+
+	if (mpcs->recovery_cooldown &&
+	    time_before(jiffies, mpcs->recovery_cooldown))
+		goto out;
+
+	if (mpcs->recovery_cooldown) {
+		mpcs->recovery_attempts = 0;
+		mpcs->recovery_cooldown = 0;
+	}
+
+	if (++mpcs->rx_unlock_polls < MTK_USXGMII_RX_UNLOCK_POLLS)
+		goto out;
+
+	mpcs->rx_unlock_polls = 0;
+	dev_warn(mpcs->dev, "USXGMII RX remains unlocked; recovery attempt %u\n",
+		 mpcs->recovery_attempts + 1);
+
+	ret = mtk_usxgmii_apply_config(mpcs, mpcs->neg_mode,
+				       mpcs->interface, true);
+	if (!ret && mpcs->link_speed != SPEED_UNKNOWN)
+		ret = mtk_usxgmii_set_rate_adaptation(mpcs,
+						      mpcs->link_speed);
+	if (ret)
+		dev_warn(mpcs->dev, "USXGMII recovery failed: %d\n", ret);
+
+	if (++mpcs->recovery_attempts >= MTK_USXGMII_MAX_RECOVERY_ATTEMPTS)
+		mpcs->recovery_cooldown = jiffies +
+					  MTK_USXGMII_RECOVERY_COOLDOWN;
+
+out:
+	mutex_unlock(&mpcs->config_lock);
+
+	if (READ_ONCE(mpcs->enabled))
+		mod_delayed_work(system_wq, &mpcs->recovery_work,
+				 MTK_USXGMII_RECOVERY_INTERVAL);
 }
 
 static int mtk_usxgmii_pcs_enable(struct phylink_pcs *pcs)
 {
 	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
+	int ret;
 
-	phy_power_on(mpcs->xfi_tphy);
+	mutex_lock(&mpcs->config_lock);
+	ret = phy_power_on(mpcs->xfi_tphy);
+	if (!ret)
+		WRITE_ONCE(mpcs->enabled, true);
+	mutex_unlock(&mpcs->config_lock);
+
+	if (!ret)
+		mod_delayed_work(system_wq, &mpcs->recovery_work,
+				 MTK_USXGMII_RECOVERY_INTERVAL);
 
-	return 0;
+	return ret;
 }
 
 static void mtk_usxgmii_pcs_disable(struct phylink_pcs *pcs)
 {
 	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
 
+	WRITE_ONCE(mpcs->enabled, false);
+	cancel_delayed_work_sync(&mpcs->recovery_work);
+
+	mutex_lock(&mpcs->config_lock);
 	mpcs->interface = PHY_INTERFACE_MODE_NA;
 	mpcs->neg_mode = -1;
+	mpcs->link_speed = SPEED_UNKNOWN;
+	mpcs->rx_unlock_polls = 0;
+	mpcs->recovery_attempts = 0;
+	mpcs->recovery_cooldown = 0;
 
 	phy_power_off(mpcs->xfi_tphy);
+	mutex_unlock(&mpcs->config_lock);
 }
 
 static unsigned int mtk_usxgmii_pcs_inband_caps(struct phylink_pcs *pcs,
@@ -431,7 +638,11 @@ static int mtk_usxgmii_probe(struct platform_device *pdev)
 	mpcs->pcs.poll = true;
 	mpcs->interface = PHY_INTERFACE_MODE_NA;
 	mpcs->neg_mode = -1;
+	mpcs->link_speed = SPEED_UNKNOWN;
 	mpcs->fwnode = fwnode_handle_get(dev_fwnode(dev));
+	mutex_init(&mpcs->config_lock);
+	mutex_init(&mpcs->reg_lock);
+	INIT_DELAYED_WORK(&mpcs->recovery_work, mtk_usxgmii_recovery_work);
 
 	__set_bit(PHY_INTERFACE_MODE_5GBASER, mpcs->pcs.supported_interfaces);
 	__set_bit(PHY_INTERFACE_MODE_10GBASER, mpcs->pcs.supported_interfaces);
@@ -460,6 +671,9 @@ static void mtk_usxgmii_remove(struct platform_device *pdev)
 {
 	struct mtk_usxgmii_pcs *mpcs = platform_get_drvdata(pdev);
 
+	WRITE_ONCE(mpcs->enabled, false);
+	cancel_delayed_work_sync(&mpcs->recovery_work);
+
 	fwnode_pcs_del_provider(dev_fwnode(&pdev->dev));
 
 	rtnl_lock();
--- a/drivers/phy/mediatek/phy-mtk-xfi-tphy.c
+++ b/drivers/phy/mediatek/phy-mtk-xfi-tphy.c
@@ -63,6 +63,7 @@
  * @reset: Reset control corresponding to the phy instance.
  * @clocks: All clocks required for the phy to operate.
  * @da_war: Enables work-around for 10GBase-R mode.
+ * @interface: Currently configured Ethernet interface mode.
  */
 struct mtk_xfi_tphy {
 	void __iomem		*base;
@@ -70,6 +71,7 @@ struct mtk_xfi_tphy {
 	struct reset_control	*reset;
 	struct clk_bulk_data	clocks[MTK_XFI_TPHY_NUM_CLOCKS];
 	bool			da_war;
+	phy_interface_t		interface;
 };
 
 /**
@@ -300,6 +302,7 @@ static int mtk_xfi_tphy_set_mode(struct phy *phy, enum phy_mode mode, int
 	case PHY_INTERFACE_MODE_10GBASER:
 	case PHY_INTERFACE_MODE_USXGMII:
 		mtk_xfi_tphy_setup(xfi_tphy, submode);
+		xfi_tphy->interface = submode;
 		return 0;
 	default:
 		return -EINVAL;
@@ -307,6 +310,27 @@ static int mtk_xfi_tphy_set_mode(struct phy *phy, enum phy_mode mode, int
 }
 
 /**
+ * mtk_xfi_tphy_calibrate() - Reapply tuning after a controlled PHY reset.
+ * @phy: PHY instance.
+ *
+ * The generic PHY consumer calls this only from its bounded recovery path.
+ * Reapply the complete setup for the last successfully selected interface.
+ *
+ * Return: 0 on success or %-EINVAL before an interface has been selected.
+ */
+static int mtk_xfi_tphy_calibrate(struct phy *phy)
+{
+	struct mtk_xfi_tphy *xfi_tphy = phy_get_drvdata(phy);
+
+	if (xfi_tphy->interface == PHY_INTERFACE_MODE_NA)
+		return -EINVAL;
+
+	mtk_xfi_tphy_setup(xfi_tphy, xfi_tphy->interface);
+
+	return 0;
+}
+
+/**
  * mtk_xfi_tphy_reset() - Reset the phy.
  *
  * @phy: Phy instance.
@@ -369,6 +393,7 @@ static const struct phy_ops mtk_xfi_tphy_ops = {
 	.power_off	= mtk_xfi_tphy_power_off,
 	.set_mode	= mtk_xfi_tphy_set_mode,
 	.reset		= mtk_xfi_tphy_reset,
+	.calibrate	= mtk_xfi_tphy_calibrate,
 	.owner		= THIS_MODULE,
 };
 
@@ -419,6 +444,7 @@ static int mtk_xfi_tphy_probe(struct platform_device *pdev)
 		return PTR_ERR(xfi_tphy->reset);
 
 	xfi_tphy->da_war = of_property_read_bool(np, "mediatek,usxgmii-performance-errata");
+	xfi_tphy->interface = PHY_INTERFACE_MODE_NA;
 
 	phy = devm_phy_create(&pdev->dev, NULL, &mtk_xfi_tphy_ops);
 	if (IS_ERR(phy))
