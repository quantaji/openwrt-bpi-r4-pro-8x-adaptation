+	unsigned int num_queues;
+	int queue_snapshot_result;
+	int last_result;
+};
+
+void mxl862xx_diag_init(struct mxl862xx_priv *priv);
+void mxl862xx_diag_teardown(struct mxl862xx_priv *priv);
+
+#endif /* __MXL862XX_DIAG_H */
