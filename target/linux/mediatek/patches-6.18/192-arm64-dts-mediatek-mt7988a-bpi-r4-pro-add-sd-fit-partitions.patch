From: Frank Wunderlich <frank-w@public-files.de>
Date: Tue, 27 Jan 2026 00:00:00 +0200
Subject: [PATCH] arm64: dts: mediatek: mt7988a-bpi-r4-pro: add SD FIT
 partition

Add the OpenWrt GPT partition description required for booting the
production FIT from SD.

Adapted from the SD portion of OpenWrt PR #21083. The original patch also
covers eMMC and SPI-NAND; those parts are intentionally excluded because
M02 owns only read-only SD boot.

Original-OpenWrt-Commit: 77ccc1b2ba9b6c607931c45f47d3d7d5a7d89a7d
Original-Patch: target/linux/mediatek/patches-6.18/192-arm64-dts-mediatek-mt7988a-bpi-r4-pro-add-fit-partitions.patch
Signed-off-by: Frank Wunderlich <frank-w@public-files.de>
Signed-off-by: Codex <codex@openai.com>
---

--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-sd.dtso
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro-sd.dtso
@@ -27,5 +27,29 @@
 	#address-cells = <1>;
 	#size-cells = <0>;
 	status = "okay";
+
+	card@0 {
+		compatible = "mmc-card";
+		reg = <0>;
+
+		partitions {
+			compatible = "gpt-partitions";
+
+			block-partition-env {
+				partname = "ubootenv";
+
+				nvmem-layout {
+					compatible = "u-boot,env-layout";
+				};
+			};
+
+			sd_rootfs: block-partition-production {
+				partname = "production";
+			};
+		};
+	};
 };
 
+&{/chosen} {
+	rootdisk-sd = <&sd_rootfs>;
+};
