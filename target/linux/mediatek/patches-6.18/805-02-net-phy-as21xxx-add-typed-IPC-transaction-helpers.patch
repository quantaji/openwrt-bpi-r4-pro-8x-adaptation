 static int as21xxx_read_link(struct phy_device *phydev, int *bmcr)
@@ -913,7 +996,6 @@ static int as21xxx_match_phy_device(struct phy_device *phydev,
 				    const struct phy_driver *phydrv)
 {
 	struct as21xxx_priv *priv;
-	u16 ret_sts;
 	u32 phy_id;
 	int ret;
 
@@ -939,7 +1021,13 @@ static int as21xxx_match_phy_device(struct phy_device *phydev,
 	if (phy_id != PHY_ID_AS21XXX)
