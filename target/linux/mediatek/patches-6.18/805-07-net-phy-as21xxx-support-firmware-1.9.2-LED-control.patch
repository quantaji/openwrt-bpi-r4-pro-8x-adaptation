+static int as21xxx_apply_led_config_locked(struct phy_device *phydev)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+
+	lockdep_assert_held(&priv->ipc_lock);
+
+	if (!priv->firmware_config_ready)
+		return 0;
+
+	return as21xxx_ipc_xfer_locked(phydev, IPC_CMD_SET_LED,
+				       priv->led_config,
+				       ARRAY_SIZE(priv->led_config),
+				       NULL, 0, NULL);
+}
+
 static int as21xxx_config_init(struct phy_device *phydev)
 {
 	struct as21xxx_priv *priv = phydev->priv;
@@ -756,7 +770,16 @@ static int as21xxx_config_init(struct phy_device *phydev)
 	if (ret)
 		return ret;
 
-	return as21xxx_dpc_ra_enable(phydev);
+	ret = as21xxx_dpc_ra_enable(phydev);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->ipc_lock);
+	priv->firmware_config_ready = true;
+	ret = as21xxx_apply_led_config_locked(phydev);
+	mutex_unlock(&priv->ipc_lock);
+
+	return ret;
 }
 
