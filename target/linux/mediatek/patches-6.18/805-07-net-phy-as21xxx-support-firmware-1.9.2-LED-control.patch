+				mode = as21xxx_led_supported_pattern[i].mode;
+				break;
+			}
+
+		if (i == ARRAY_SIZE(as21xxx_led_supported_pattern))
+			return -EOPNOTSUPP;
+	}
+
+	mutex_lock(&priv->ipc_lock);
+	priv->led_config[index] = mode;
+	ret = as21xxx_apply_led_config_locked(phydev);
+	mutex_unlock(&priv->ipc_lock);
 
