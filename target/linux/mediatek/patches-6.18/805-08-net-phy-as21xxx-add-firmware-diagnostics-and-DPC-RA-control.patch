+#define AS21XXX_DIAG_RA_VALID		BIT(2)
+#define AS21XXX_DIAG_PCS_CONFIG_VALID	BIT(3)
 
 #define AEON_BOOT_ADDR			0x1000
 #define AEON_CPU_BOOT_ADDR		0x2000
@@ -184,7 +220,21 @@ struct as21xxx_priv {
 	bool ipc_parity;
 	bool cu_an_top_speed_valid;
 	bool firmware_config_ready;
+	bool diag_pcs_attempted;
+	bool diag_pcs_before_valid;
+	bool diag_pcs_after_valid;
+	bool diag_pcs_verified;
 	u16 cu_an_top_speed;
+	u16 diag_pcs_request_speed;
+	u16 diag_pcs_before_speed;
+	u16 diag_pcs_after_speed;
+	u8 diag_pcs_request_encoding;
+	u8 diag_pcs_request_op_mode;
+	u8 diag_pcs_before_encoding;
+	u8 diag_pcs_before_op_mode;
