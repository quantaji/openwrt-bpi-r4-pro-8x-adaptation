 #define   AEON_IPC_STS_PARITY		BIT(15)
@@ -147,6 +154,35 @@
 #define AEON_IPC_TIMEOUT_US		2000000
 #define AEON_IPC_DATA_NUM_REGISTERS	8
 #define AEON_IPC_DATA_MAX		(AEON_IPC_DATA_NUM_REGISTERS * sizeof(u16))
+#define AS21XXX_DBGCMD_POLL_MAX		100
+
+#define AS21XXX_DBGCMD_NGPHY		0x80
+#define AS21XXX_DBGCMD_DPC		0x8b
+#define AS21XXX_DBGCMD_NGPHY_CNT_DUMP	4
+#define AS21XXX_DBGCMD_NGPHY_CNT_CLEAR	5
+#define AS21XXX_DBGCMD_DPC_PCS_SET	0
+#define AS21XXX_DBGCMD_DPC_PCS_GET	1
+#define AS21XXX_DBGCMD_DPC_RA_SET	2
+#define AS21XXX_DBGCMD_DPC_RA_GET	7
+#define AS21XXX_DBGCMD_DPC_CNT_DUMP	13
+#define AS21XXX_DBGCMD_DPC_CNT_CLEAR	14
