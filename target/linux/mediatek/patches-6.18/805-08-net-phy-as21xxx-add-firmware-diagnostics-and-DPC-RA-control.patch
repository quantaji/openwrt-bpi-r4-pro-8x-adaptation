+static int as21xxx_get_sset_count(struct phy_device *phydev)
+{
+	return AS21XXX_STAT_COUNT;
+}
+
+static void as21xxx_get_strings(struct phy_device *phydev, u8 *data)
+{
+	int i;
+
+	for (i = 0; i < AS21XXX_STAT_COUNT; i++)
+		ethtool_puts(&data, as21xxx_diag_stat_names[i]);
+}
+
+static void as21xxx_get_stats(struct phy_device *phydev,
+			      struct ethtool_stats *stats, u64 *data)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+	u32 counters[AS21XXX_FW_COUNTERS];
+	u32 valid = 0;
+	u16 speed;
+	bool ra_enabled;
+	u8 pcs_encoding;
+	u8 op_mode;
+	int ret;
+	int i;
+
+	for (i = 0; i < AS21XXX_STAT_COUNT; i++)
+		data[i] = U64_MAX;
+
+	ret = as21xxx_read_fw_counters(phydev, counters);
+	if (!ret) {
+		for (i = 0; i < AS21XXX_FW_COUNTERS; i++)
+			data[i] = counters[i];
+		valid |= AS21XXX_DIAG_COUNTERS_VALID;
+	} else {
+		phydev_dbg(phydev, "failed to read firmware counters: %pe\n",
+			   ERR_PTR(ret));
+	}
+
+	ret = as21xxx_dpc_pcs_get(phydev, &pcs_encoding, &speed, &op_mode);
+	if (!ret) {
+		data[AS21XXX_STAT_PCS_64B66B] = pcs_encoding;
+		data[AS21XXX_STAT_SERDES_SPEED] = speed;
+		data[AS21XXX_STAT_PCS_OP_MODE] = op_mode;
+		valid |= AS21XXX_DIAG_PCS_VALID;
+	} else {
+		phydev_dbg(phydev, "failed to read firmware PCS state: %pe\n",
+			   ERR_PTR(ret));
+	}
+
+	ret = as21xxx_dpc_ra_get(phydev, &ra_enabled);
+	if (!ret) {
+		data[AS21XXX_STAT_DPC_RA_MODE] = ra_enabled;
+		valid |= AS21XXX_DIAG_RA_VALID;
+	} else {
+		phydev_dbg(phydev, "failed to read firmware DPC RA state: %pe\n",
+			   ERR_PTR(ret));
+	}
+
+	data[AS21XXX_STAT_PCS_CFG_ATTEMPTED] = priv->diag_pcs_attempted;
+	if (priv->diag_pcs_attempted) {
+		data[AS21XXX_STAT_PCS_REQ_64B66B] =
+			priv->diag_pcs_request_encoding;
+		data[AS21XXX_STAT_PCS_REQ_SPEED] =
+			priv->diag_pcs_request_speed;
+		data[AS21XXX_STAT_PCS_REQ_OP_MODE] =
+			priv->diag_pcs_request_op_mode;
+		data[AS21XXX_STAT_PCS_BEFORE_VALID] =
+			priv->diag_pcs_before_valid;
+		if (priv->diag_pcs_before_valid) {
+			data[AS21XXX_STAT_PCS_BEFORE_64B66B] =
+				priv->diag_pcs_before_encoding;
+			data[AS21XXX_STAT_PCS_BEFORE_SPEED] =
+				priv->diag_pcs_before_speed;
+			data[AS21XXX_STAT_PCS_BEFORE_OP_MODE] =
+				priv->diag_pcs_before_op_mode;
+		}
+		data[AS21XXX_STAT_PCS_AFTER_VALID] =
+			priv->diag_pcs_after_valid;
+		if (priv->diag_pcs_after_valid) {
+			data[AS21XXX_STAT_PCS_AFTER_64B66B] =
+				priv->diag_pcs_after_encoding;
+			data[AS21XXX_STAT_PCS_AFTER_SPEED] =
+				priv->diag_pcs_after_speed;
+			data[AS21XXX_STAT_PCS_AFTER_OP_MODE] =
+				priv->diag_pcs_after_op_mode;
+			valid |= AS21XXX_DIAG_PCS_CONFIG_VALID;
+		}
+		data[AS21XXX_STAT_PCS_CFG_ERRNO] =
+			priv->diag_pcs_result < 0 ? -priv->diag_pcs_result : 0;
+		data[AS21XXX_STAT_PCS_CFG_VERIFIED] =
+			priv->diag_pcs_verified;
+	}
+
+	data[AS21XXX_STAT_VALID_MASK] = valid;
+}
+
+static int as21xxx_debugfs_dpc_ra_get(void *data, u64 *value)
+{
+	struct phy_device *phydev = data;
+	bool enabled;
+	int ret;
+
+	ret = as21xxx_dpc_ra_get(phydev, &enabled);
+	if (!ret)
+		*value = enabled;
+
+	return ret;
+}
+
+static int as21xxx_debugfs_dpc_ra_set(void *data, u64 value)
+{
+	struct phy_device *phydev = data;
+	bool requested = value;
+	bool old_value;
+	bool readback;
+	int restore_ret;
+	int ret;
+
+	if (value > 1)
+		return -EINVAL;
+
+	rtnl_lock();
+	if (phydev->attached_dev && netif_running(phydev->attached_dev)) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	ret = as21xxx_dpc_ra_get(phydev, &old_value);
+	if (ret || old_value == requested)
+		goto out;
+
+	ret = as21xxx_dpc_ra_set(phydev, requested);
+	if (ret)
+		goto out;
+
+	ret = as21xxx_dpc_ra_get(phydev, &readback);
+	if (!ret && readback == requested)
+		goto out;
+
+	restore_ret = as21xxx_dpc_ra_set(phydev, old_value);
+	if (restore_ret)
+		phydev_err(phydev, "failed to restore DPC RA mode: %pe\n",
+			   ERR_PTR(restore_ret));
+	if (!ret)
+		ret = -EIO;
+
+out:
+	rtnl_unlock();
+
+	return ret;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(as21xxx_debugfs_dpc_ra_fops,
+			 as21xxx_debugfs_dpc_ra_get,
+			 as21xxx_debugfs_dpc_ra_set, "%llu\n");
+
+static int as21xxx_debugfs_counter_clear_get(void *data, u64 *value)
+{
+	*value = 0;
+	return 0;
+}
+
+static int as21xxx_debugfs_counter_clear_set(void *data, u64 value)
+{
+	struct phy_device *phydev = data;
+	int ret;
+
+	if (value != 1)
+		return -EINVAL;
+
+	ret = as21xxx_ipc_debug_xfer(phydev, AS21XXX_DBGCMD_CU_AN,
+				     AS21XXX_DBGCMD_CU_AN_CNT_CLEAR,
+				     NULL, 0, NULL, 0);
+	if (ret)
+		return ret;
+
+	ret = as21xxx_ipc_debug_xfer(phydev, AS21XXX_DBGCMD_NGPHY,
+				     AS21XXX_DBGCMD_NGPHY_CNT_CLEAR,
+				     NULL, 0, NULL, 0);
+	if (ret)
+		return ret;
+
+	return as21xxx_ipc_debug_xfer(phydev, AS21XXX_DBGCMD_DPC,
+				      AS21XXX_DBGCMD_DPC_CNT_CLEAR,
+				      NULL, 0, NULL, 0);
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(as21xxx_debugfs_counter_clear_fops,
+			 as21xxx_debugfs_counter_clear_get,
+			 as21xxx_debugfs_counter_clear_set, "%llu\n");
+
+static void as21xxx_debugfs_remove(void *data)
+{
+	debugfs_remove(data);
+}
+
+static void as21xxx_debugfs_register(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	struct dentry *root;
+	struct dentry *file;
+	char *name;
+	int ret;
+
+	name = devm_kasprintf(dev, GFP_KERNEL, "as21xxx-%s", dev_name(dev));
+	if (!name)
+		return;
+
+	root = debugfs_create_dir(name, NULL);
+	if (IS_ERR_OR_NULL(root))
+		return;
+
+	file = debugfs_create_file("dpc_ra_mode", 0600, root, phydev,
+				   &as21xxx_debugfs_dpc_ra_fops);
+	if (IS_ERR_OR_NULL(file)) {
+		debugfs_remove(root);
+		return;
+	}
+
+	if (of_property_read_bool(phydev->mdio.dev.of_node,
+				  AS21XXX_DIAG_PCS_PROPERTY)) {
+		file = debugfs_create_file("fw_counter_clear", 0600, root,
+					   phydev,
+					   &as21xxx_debugfs_counter_clear_fops);
+		if (IS_ERR_OR_NULL(file))
+			phydev_warn(phydev,
+				    "failed to create counter-clear debugfs file\n");
+	}
+
+	ret = devm_add_action_or_reset(dev, as21xxx_debugfs_remove, root);
+	if (ret)
+		phydev_warn(phydev, "failed to register debugfs cleanup: %pe\n",
+			    ERR_PTR(ret));
+}
