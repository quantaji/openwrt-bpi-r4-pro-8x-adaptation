+	u8 diag_pcs_after_op_mode;
+	int diag_pcs_result;
 	u16 led_config[AS21XXX_LED_CONFIG_WORDS];
 	/* Protect concurrent IPC access */
 	struct mutex ipc_lock;
@@ -486,7 +536,7 @@ static int as21xxx_ipc_wait_ready(struct phy_device *phydev, bool parity)
 
 static int as21xxx_ipc_send_cmd_locked(struct phy_device *phydev,
 				       struct as21xxx_priv *priv,
-				       u16 opcode, unsigned int tx_words,
+				       u16 opcode, unsigned int tx_bytes,
 				       bool wait_status, u16 *sts)
 {
 	bool parity;
@@ -499,7 +549,7 @@ static int as21xxx_ipc_send_cmd_locked(struct phy_device *phydev,
 	 * to keep firmware and driver packet order in sync.
 	 */
 	parity = priv->ipc_parity;
-	cmd = FIELD_PREP(AEON_IPC_CMD_SIZE, tx_words * sizeof(u16)) |
+	cmd = FIELD_PREP(AEON_IPC_CMD_SIZE, tx_bytes) |
 	      FIELD_PREP(AEON_IPC_CMD_OPCODE, opcode);
 
 	if (parity)
@@ -522,11 +572,12 @@ static int as21xxx_ipc_send_cmd_locked(struct phy_device *phydev,
 }
 
 static int as21xxx_ipc_xfer_locked(struct phy_device *phydev, u16 opcode,
-				   const u16 *tx, unsigned int tx_words,
-				   u16 *rx, unsigned int rx_words,
+				   const u16 *tx, unsigned int tx_bytes,
+				   u16 *rx, unsigned int rx_capacity_bytes,
 				   unsigned int *rx_bytes)
 {
 	struct as21xxx_priv *priv = phydev->priv;
+	unsigned int tx_words = DIV_ROUND_UP(tx_bytes, sizeof(u16));
 	unsigned int ret_bytes;
 	u16 sts;
 	int ret;
@@ -535,10 +586,10 @@ static int as21xxx_ipc_xfer_locked(struct phy_device *phydev, u16 opcode,
 	lockdep_assert_held(&priv->ipc_lock);
 
 	/* IPC uses eight 16-bit data registers. */
-	if (tx_words > AEON_IPC_DATA_NUM_REGISTERS ||
-	    rx_words > AEON_IPC_DATA_NUM_REGISTERS)
+	if (tx_bytes > AEON_IPC_DATA_MAX ||
+	    rx_capacity_bytes > AEON_IPC_DATA_MAX)
 		return -EMSGSIZE;
-	if ((tx_words && !tx) || (rx_words && !rx))
+	if ((tx_bytes && !tx) || (rx_capacity_bytes && !rx))
 		return -EINVAL;
 
 	for (i = 0; i < tx_words; i++) {
@@ -549,7 +600,7 @@ static int as21xxx_ipc_xfer_locked(struct phy_device *phydev, u16 opcode,
 	}
 
 	ret = as21xxx_ipc_send_cmd_locked(phydev, priv, opcode,
-					  tx_words, true, &sts);
+					  tx_bytes, true, &sts);
 	if (ret)
 		return ret;
 
@@ -569,7 +620,7 @@ static int as21xxx_ipc_xfer_locked(struct phy_device *phydev, u16 opcode,
 		return 0;
 	}
 
-	if (ret_bytes > rx_words * sizeof(u16))
+	if (ret_bytes > rx_capacity_bytes)
 		return -EMSGSIZE;
 
 	/* Read returned bytes from IPC data registers. */
@@ -588,16 +639,102 @@ static int as21xxx_ipc_xfer_locked(struct phy_device *phydev, u16 opcode,
 }
 
 static int as21xxx_ipc_xfer(struct phy_device *phydev, u16 opcode,
-			    const u16 *tx, unsigned int tx_words,
-			    u16 *rx, unsigned int rx_words,
+			    const u16 *tx, unsigned int tx_bytes,
+			    u16 *rx, unsigned int rx_capacity_bytes,
 			    unsigned int *rx_bytes)
 {
 	struct as21xxx_priv *priv = phydev->priv;
 	int ret;
 
 	mutex_lock(&priv->ipc_lock);
-	ret = as21xxx_ipc_xfer_locked(phydev, opcode, tx, tx_words,
-				      rx, rx_words, rx_bytes);
+	ret = as21xxx_ipc_xfer_locked(phydev, opcode, tx, tx_bytes,
+				      rx, rx_capacity_bytes, rx_bytes);
+	mutex_unlock(&priv->ipc_lock);
+
+	return ret;
+}
+
+/* Run one firmware DBGCMD transaction without allowing another mailbox user
+ * to interleave WBUF, POLL or RBUF commands.
+ */
+static int as21xxx_ipc_debug_xfer(struct phy_device *phydev, u16 section,
+				  u16 command, const u8 *tx_data,
+				  unsigned int tx_len, u8 *rx_data,
+				  unsigned int rx_len)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+	u16 frame[] = { (section << 8) | command, tx_len, 0 };
+	u16 payload[AEON_IPC_DATA_NUM_REGISTERS] = {};
+	unsigned int offset = 0;
+	unsigned int reply_len;
+	u16 done = 0;
+	int ret = 0;
+	int i;
+
+	if (tx_len > AEON_IPC_DATA_MAX || (tx_len && !tx_data) ||
+	    (rx_len && !rx_data))
+		return -EINVAL;
+
+	mutex_lock(&priv->ipc_lock);
+
+	ret = as21xxx_ipc_xfer_locked(phydev, IPC_CMD_DBGCMD, frame,
+				      sizeof(frame), NULL, 0, NULL);
+	if (ret)
+		goto out;
+
+	if (tx_len) {
+		for (i = 0; i < tx_len; i++)
+			payload[i / 2] |= tx_data[i] << (8 * (i % 2));
+
+		ret = as21xxx_ipc_xfer_locked(phydev, IPC_CMD_DBGWBUF,
+					      payload, tx_len, NULL, 0, NULL);
+		if (ret)
+			goto out;
+	}
+
+	for (i = 0; i < AS21XXX_DBGCMD_POLL_MAX; i++) {
+		memset(payload, 0, sizeof(payload));
+		ret = as21xxx_ipc_xfer_locked(phydev, IPC_CMD_DBGPOLL,
+					      NULL, 0, payload,
+					      sizeof(payload), &reply_len);
+		if (ret)
+			goto out;
+		if (reply_len < sizeof(done)) {
+			ret = -EPROTO;
+			goto out;
+		}
+		done = payload[0];
+		if (done)
+			break;
+	}
+
+	if (!done) {
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+
+	while (offset < rx_len) {
+		unsigned int chunk = min_t(unsigned int, rx_len - offset,
+					   AEON_IPC_DATA_MAX);
+
+		memset(payload, 0, sizeof(payload));
+		ret = as21xxx_ipc_xfer_locked(phydev, IPC_CMD_DBGRBUF,
+					      NULL, 0, payload,
+					      sizeof(payload), &reply_len);
+		if (ret)
+			goto out;
+		if (reply_len < chunk) {
+			ret = -EPROTO;
+			goto out;
+		}
+
+		for (i = 0; i < chunk; i++)
+			rx_data[offset + i] =
+				payload[i / 2] >> (8 * (i % 2));
+		offset += chunk;
+	}
+
+out:
 	mutex_unlock(&priv->ipc_lock);
 
 	return ret;
@@ -675,8 +812,8 @@ static int as21xxx_ipc_read_fw_version(struct phy_device *phydev,
 	if (!len)
 		return -EINVAL;
 
-	ret = as21xxx_ipc_xfer(phydev, IPC_CMD_INFO, tx, ARRAY_SIZE(tx),
-			       rx, ARRAY_SIZE(rx), &rx_bytes);
+	ret = as21xxx_ipc_xfer(phydev, IPC_CMD_INFO, tx, sizeof(tx),
+			       rx, sizeof(rx), &rx_bytes);
 	if (ret)
 		return ret;
 
@@ -688,6 +825,198 @@ static int as21xxx_ipc_read_fw_version(struct phy_device *phydev,
 	return 0;
 }
 
+static int as21xxx_read_counter_block(struct phy_device *phydev, u16 section,
+				      u16 command, u32 *counters,
+				      unsigned int count)
+{
+	u8 raw[AS21XXX_NGPHY_STATS * sizeof(u32)] = {};
+	unsigned int i;
+	int ret;
+
+	if (!counters || count > AS21XXX_NGPHY_STATS)
+		return -EINVAL;
+
+	ret = as21xxx_ipc_debug_xfer(phydev, section, command, NULL, 0,
+				     raw, count * sizeof(u32));
+	if (ret)
+		return ret;
+
+	for (i = 0; i < count; i++)
+		counters[i] = get_unaligned_le32(raw + i * sizeof(u32));
+
+	return 0;
+}
+
+static int as21xxx_read_fw_counters(struct phy_device *phydev, u32 *counters)
+{
+	int ret;
+
+	ret = as21xxx_read_counter_block(phydev, AS21XXX_DBGCMD_NGPHY,
+					 AS21XXX_DBGCMD_NGPHY_CNT_DUMP,
+					 counters, AS21XXX_NGPHY_STATS);
+	if (ret)
+		return ret;
+
+	ret = as21xxx_read_counter_block(phydev, AS21XXX_DBGCMD_CU_AN,
+					 AS21XXX_DBGCMD_CU_AN_CNT_GET,
+					 counters + AS21XXX_NGPHY_STATS,
+					 AS21XXX_CU_AN_STATS);
+	if (ret)
+		return ret;
+
+	return as21xxx_read_counter_block(phydev, AS21XXX_DBGCMD_DPC,
+					  AS21XXX_DBGCMD_DPC_CNT_DUMP,
+					  counters + AS21XXX_NGPHY_STATS +
+					  AS21XXX_CU_AN_STATS,
+					  AS21XXX_DPC_STATS);
+}
+
+static int as21xxx_dpc_pcs_get(struct phy_device *phydev, u8 *pcs_encoding,
+			       u16 *speed, u8 *op_mode)
+{
+	u8 config[3] = {};
+	int ret;
+
+	ret = as21xxx_ipc_debug_xfer(phydev, AS21XXX_DBGCMD_DPC,
+				     AS21XXX_DBGCMD_DPC_PCS_GET,
+				     NULL, 0, config, sizeof(config));
+	if (ret)
+		return ret;
+
+	if (config[0] > 1)
+		return -EPROTO;
+
+	switch (config[1]) {
+	case 0:
+		*speed = SPEED_1000;
+		break;
+	case 1:
+		*speed = SPEED_2500;
+		break;
+	case 2:
+		*speed = SPEED_5000;
+		break;
+	case 3:
+		*speed = SPEED_10000;
+		break;
+	default:
+		return -EPROTO;
+	}
+
+	*pcs_encoding = config[0];
+	*op_mode = config[2];
+
+	return 0;
+}
+
+static int as21xxx_dpc_pcs_set(struct phy_device *phydev, u8 pcs_encoding,
+			       u8 speed, u8 op_mode)
+{
+	u8 config[] = { pcs_encoding, speed, op_mode };
+
+	return as21xxx_ipc_debug_xfer(phydev, AS21XXX_DBGCMD_DPC,
+				      AS21XXX_DBGCMD_DPC_PCS_SET,
+				      config, sizeof(config), NULL, 0);
+}
+
+static int as21xxx_configure_dpc_pcs(struct phy_device *phydev)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+	u8 speed;
+	int ret;
+
+	if (!of_property_read_bool(phydev->mdio.dev.of_node,
+				   AS21XXX_DIAG_PCS_PROPERTY))
+		return 0;
+
+	priv->diag_pcs_attempted = true;
+	priv->diag_pcs_request_op_mode = 0;
+
+	switch (phydev->interface) {
+	case PHY_INTERFACE_MODE_USXGMII:
+	case PHY_INTERFACE_MODE_10GBASER:
+		priv->diag_pcs_request_encoding = 1;
+		priv->diag_pcs_request_speed = SPEED_10000;
+		speed = 3;
+		break;
+	case PHY_INTERFACE_MODE_5GBASER:
+		priv->diag_pcs_request_encoding = 1;
+		priv->diag_pcs_request_speed = SPEED_5000;
+		speed = 2;
+		break;
+	case PHY_INTERFACE_MODE_2500BASEX:
+		priv->diag_pcs_request_encoding = 0;
+		priv->diag_pcs_request_speed = SPEED_2500;
+		speed = 1;
+		break;
+	case PHY_INTERFACE_MODE_SGMII:
+		priv->diag_pcs_request_encoding = 0;
+		priv->diag_pcs_request_speed = SPEED_1000;
+		speed = 0;
+		break;
+	default:
+		priv->diag_pcs_result = -EOPNOTSUPP;
+		return priv->diag_pcs_result;
+	}
+
+	ret = as21xxx_dpc_pcs_get(phydev, &priv->diag_pcs_before_encoding,
+				  &priv->diag_pcs_before_speed,
+				  &priv->diag_pcs_before_op_mode);
+	if (!ret)
+		priv->diag_pcs_before_valid = true;
+
+	ret = as21xxx_dpc_pcs_set(phydev, priv->diag_pcs_request_encoding,
+				  speed, priv->diag_pcs_request_op_mode);
+	if (ret)
+		goto out;
+
+	ret = as21xxx_dpc_pcs_get(phydev, &priv->diag_pcs_after_encoding,
+				  &priv->diag_pcs_after_speed,
+				  &priv->diag_pcs_after_op_mode);
+	if (ret)
+		goto out;
+
+	priv->diag_pcs_after_valid = true;
+	if (priv->diag_pcs_after_encoding !=
+	    priv->diag_pcs_request_encoding ||
+	    priv->diag_pcs_after_speed != priv->diag_pcs_request_speed ||
+	    priv->diag_pcs_after_op_mode != priv->diag_pcs_request_op_mode)
+		ret = -EIO;
+	else
+		priv->diag_pcs_verified = true;
+
+out:
+	priv->diag_pcs_result = ret;
+	return ret;
+}
+
+static int as21xxx_dpc_ra_get(struct phy_device *phydev, bool *enabled)
+{
+	u8 value = 0;
+	int ret;
+
+	ret = as21xxx_ipc_debug_xfer(phydev, AS21XXX_DBGCMD_DPC,
+				     AS21XXX_DBGCMD_DPC_RA_GET,
+				     NULL, 0, &value, sizeof(value));
+	if (ret)
+		return ret;
+	if (value > 1)
+		return -EPROTO;
+
+	*enabled = value;
+
+	return 0;
+}
+
+static int as21xxx_dpc_ra_set(struct phy_device *phydev, bool enabled)
+{
+	u8 value = enabled;
+
+	return as21xxx_ipc_debug_xfer(phydev, AS21XXX_DBGCMD_DPC,
+				      AS21XXX_DBGCMD_DPC_RA_SET,
+				      &value, sizeof(value), NULL, 0);
+}
+
 static int as21xxx_dpc_ra_enable(struct phy_device *phydev)
 {
 	u16 tx[] = {
@@ -695,10 +1024,348 @@ static int as21xxx_dpc_ra_enable(struct phy_device *phydev)
 		IPC_CFG_PARAM_DIRECT_DPC_RA,
 	};
 
-	return as21xxx_ipc_xfer(phydev, IPC_CMD_CFG_PARAM, tx, ARRAY_SIZE(tx),
+	return as21xxx_ipc_xfer(phydev, IPC_CMD_CFG_PARAM, tx, sizeof(tx),
 				NULL, 0, NULL);
 }
 
+static int as21xxx_configure_dpc_ra(struct phy_device *phydev)
+{
+	bool expected;
+	bool enabled;
+	int ret;
+
+	switch (phydev->interface) {
+	case PHY_INTERFACE_MODE_10GBASER:
+	case PHY_INTERFACE_MODE_5GBASER:
+	case PHY_INTERFACE_MODE_2500BASEX:
+	case PHY_INTERFACE_MODE_SGMII:
+		expected = false;
+		ret = as21xxx_dpc_ra_set(phydev, expected);
+		break;
+	case PHY_INTERFACE_MODE_USXGMII:
+		expected = true;
+		ret = as21xxx_dpc_ra_enable(phydev);
+		break;
+	default:
+		return as21xxx_dpc_ra_enable(phydev);
+	}
+	if (ret)
+		return ret;
+
+	ret = as21xxx_dpc_ra_get(phydev, &enabled);
+	if (ret)
+		return ret;
+
+	if (enabled != expected) {
+		phydev_err(phydev, "DPC RA readback mismatch: expected %u, got %u\n",
+			   expected, enabled);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+enum as21xxx_diag_stat {
+	AS21XXX_STAT_ERR_BLK,
+	AS21XXX_STAT_BER_CNT,
+	AS21XXX_STAT_HI_BER,
+	AS21XXX_STAT_CFR_CNT,
+	AS21XXX_STAT_LDPC_ERR,
+	AS21XXX_STAT_CU_AN_CNT,
+	AS21XXX_STAT_ETH_CRC_ERR,
+	AS21XXX_STAT_SDS_CRC_ERR,
+	AS21XXX_STAT_DPC_CNT2,
+	AS21XXX_STAT_PCS_64B66B,
+	AS21XXX_STAT_SERDES_SPEED,
+	AS21XXX_STAT_PCS_OP_MODE,
+	AS21XXX_STAT_DPC_RA_MODE,
+	AS21XXX_STAT_PCS_CFG_ATTEMPTED,
+	AS21XXX_STAT_PCS_REQ_64B66B,
+	AS21XXX_STAT_PCS_REQ_SPEED,
+	AS21XXX_STAT_PCS_REQ_OP_MODE,
+	AS21XXX_STAT_PCS_BEFORE_VALID,
+	AS21XXX_STAT_PCS_BEFORE_64B66B,
+	AS21XXX_STAT_PCS_BEFORE_SPEED,
+	AS21XXX_STAT_PCS_BEFORE_OP_MODE,
+	AS21XXX_STAT_PCS_AFTER_VALID,
+	AS21XXX_STAT_PCS_AFTER_64B66B,
+	AS21XXX_STAT_PCS_AFTER_SPEED,
+	AS21XXX_STAT_PCS_AFTER_OP_MODE,
+	AS21XXX_STAT_PCS_CFG_ERRNO,
+	AS21XXX_STAT_PCS_CFG_VERIFIED,
+	AS21XXX_STAT_VALID_MASK,
+	AS21XXX_STAT_COUNT,
+};
+
+static const char as21xxx_diag_stat_names[][ETH_GSTRING_LEN] = {
+	[AS21XXX_STAT_ERR_BLK] = "fw_err_blk",
+	[AS21XXX_STAT_BER_CNT] = "fw_ber_cnt",
+	[AS21XXX_STAT_HI_BER] = "fw_hi_ber",
+	[AS21XXX_STAT_CFR_CNT] = "fw_cfr_cnt",
+	[AS21XXX_STAT_LDPC_ERR] = "fw_ldpc_err",
+	[AS21XXX_STAT_CU_AN_CNT] = "fw_cu_an_cnt",
+	[AS21XXX_STAT_ETH_CRC_ERR] = "fw_eth_crc_err",
