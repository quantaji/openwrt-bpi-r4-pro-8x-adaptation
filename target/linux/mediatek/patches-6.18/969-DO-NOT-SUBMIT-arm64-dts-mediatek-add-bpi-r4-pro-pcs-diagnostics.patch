+};
+
+&phy18 {
+	aeonsemi,dpc-pcs-diagnostic;
+};
+
+&switch16 {
+	maxlinear,flow-control-diagnostic;
+
+	ports {
+		port@13 {
+			phy-mode = "10gbase-r";
+			phy-connection-type = "10gbase-r";
+			/delete-property/ managed;
+		};
+	};
