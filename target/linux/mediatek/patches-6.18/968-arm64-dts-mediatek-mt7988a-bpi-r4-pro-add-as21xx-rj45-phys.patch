From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 16 Aug 2026 00:00:00 -0700
Subject: [PATCH] arm64: dts: mediatek: mt7988a-bpi-r4-pro: add AS21xx and
 passive muxes

Describe the two AS21xx PHYs, their firmware and LEDs, and the two
independent passive SFP/RJ45 muxes used by BPI-R4 Pro 8X.

GMAC1 uses RJ45 PHY28 on channel 0 and SFP2 on channel 1. MxL logical
port 13 uses SFP1 on channel 0 and RJ45 PHY24 on channel 1. SFP module
presence has priority on both paths. Keep GMAC1's PCS handles on the
original MAC node and place only endpoint properties on mux channels.

Based on BPI-R4 Pro topology work by Sean McCully at OpenWrt PR revision
80f610ddf0075cf896d1e9ccaa47c0f4aa26ef98, MediaTek vendor descriptions,
and locally validated BPI-R4 Pro 8X wiring.

Signed-off-by: Codex <codex@openai.com>
---
--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-pro.dtsi
@@ -16,6 +16,8 @@
 / {
 	aliases {
 		ethernet0 = &gmac0;
+		ethernet1 = &gmac1;
+		ethernet2 = &gmac2;
 		i2c0 = &i2c0;
 		i2c1 = &i2c1;
 		i2c2 = &i2c2;
@@ -183,12 +185,52 @@
 	pinctrl-0 = <&mdio0_pins>;
 	pinctrl-names = "default";
 	status = "okay";
+
+	mux-bus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ethernet-mux@1 {
+			compatible = "mediatek,eth-mux";
+			reg = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			chan-sel-gpios = <&pio 3 GPIO_ACTIVE_HIGH>;
+			mod-def0-gpios = <&pio 1 GPIO_ACTIVE_LOW>;
+			sfp-present-channel = <1>;
+
+			channel@0 {
+				reg = <0>;
+				phy-mode = "usxgmii";
+				phy-connection-type = "usxgmii";
+				managed = "in-band-status";
+				phy-handle = <&phy28>;
+			};
+
+			channel@1 {
+				reg = <1>;
+				phy-mode = "10gbase-r";
+				phy-connection-type = "10gbase-r";
+				managed = "in-band-status";
+				sfp = <&sfp2>;
+			};
+		};
+	};
 };
 
 &gmac0 {
 	status = "okay";
 };
 
+&gmac1 {
+	phy-mode = "usxgmii";
+	phy-connection-type = "usxgmii";
+	mac-type = "xgdm";
+	managed = "in-band-status";
+	phy-handle = <&phy28>;
+	status = "okay";
+};
+
 &gmac2 {
 	phy-mode = "10gbase-r";
 	phy-connection-type = "10gbase-r";
@@ -202,6 +244,72 @@
 };
 
 &mdio_bus {
+	phy24: ethernet-phy@24 {
+		compatible = "ethernet-phy-id7500.9410",
+			     "ethernet-phy-ieee802.3-c45";
+		reg = <24>;
+		reset-gpios = <&pio 83 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <200000>;
+		reset-deassert-us = <350000>;
+		firmware-name = "as21x1x_fw.bin";
+
+		leds {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			phy24_led_0: led@0 {
+				reg = <0>;
+				function = LED_FUNCTION_LAN;
+				function-enumerator = <0>;
+				linux,default-trigger = "netdev";
+				active-high;
+				status = "okay";
+			};
+
+			phy24_led_1: led@1 {
+				reg = <1>;
+				function = LED_FUNCTION_LAN;
+				function-enumerator = <1>;
+				linux,default-trigger = "netdev";
+				active-high;
+				status = "okay";
+			};
+		};
+	};
+
+	phy28: ethernet-phy@28 {
+		compatible = "ethernet-phy-id7500.9410",
+			     "ethernet-phy-ieee802.3-c45";
+		reg = <28>;
+		reset-gpios = <&pio 82 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <200000>;
+		reset-deassert-us = <350000>;
+		firmware-name = "as21x1x_fw.bin";
+
+		leds {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			phy28_led_0: led@0 {
+				reg = <0>;
+				function = LED_FUNCTION_WAN;
+				function-enumerator = <0>;
+				linux,default-trigger = "netdev";
+				active-high;
+				status = "okay";
+			};
+
+			phy28_led_1: led@1 {
+				reg = <1>;
+				function = LED_FUNCTION_WAN;
+				function-enumerator = <1>;
+				linux,default-trigger = "netdev";
+				active-high;
+				status = "okay";
+			};
+		};
+	};
+
 	switch16: switch@16 {
 		compatible = "maxlinear,mxl86252";
 		reg = <16>;
@@ -256,6 +364,46 @@
 					full-duplex;
 				};
 			};
+
+			port@13 {
+				reg = <13>;
+				label = "mxl_lan5";
+				phy-mode = "usxgmii";
+				managed = "in-band-status";
+				phy-handle = <&phy24>;
+				status = "okay";
+			};
+		};
+
+		mux-bus {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			ds-mux@13 {
+				compatible = "mxl862xx,ds-mux";
+				reg = <13>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				chan-sel-gpios = <&pio 54 GPIO_ACTIVE_HIGH>;
+				mod-def0-gpios = <&pio 69 GPIO_ACTIVE_LOW>;
+				sfp-present-channel = <0>;
+
+				channel@0 {
+					reg = <0>;
+					phy-mode = "10gbase-r";
+					phy-connection-type = "10gbase-r";
+					managed = "in-band-status";
+					sfp = <&sfp1>;
+				};
+
+				channel@1 {
+					reg = <1>;
+					phy-mode = "usxgmii";
+					phy-connection-type = "usxgmii";
+					managed = "in-band-status";
+					phy-handle = <&phy24>;
+				};
+			};
 		};
 
 		mdio {
