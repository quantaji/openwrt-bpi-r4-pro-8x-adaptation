From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 15 Aug 2026 22:36:49 -0700
Subject: [PATCH 3/7] net: phy: as21xxx: clean up C45 read workaround

Keep the Aeonsemi-confirmed post-read dummy write, remove the unresolved FIXME and propagate its error when the original read succeeded.

Based on the tested local migration by Guangda Ji in commit ceab4fe4af329eb191d54598feffa4af2e4abf93, on top of the OpenWrt C45 workaround.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/net/phy/as21xxx.c | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/drivers/net/phy/as21xxx.c b/drivers/net/phy/as21xxx.c
index ef15a29..3520032 100644
--- a/drivers/net/phy/as21xxx.c
+++ b/drivers/net/phy/as21xxx.c
@@ -1057,19 +1057,24 @@ out:
 	return ret;
 }
 
-static int as21xxx_read_mmd(struct phy_device *phydev, int devad,
-			    u16 regnum)
+static int as21xxx_read_mmd(struct phy_device *phydev, int devad, u16 regnum)
 {
 	struct mii_bus *bus = phydev->mdio.bus;
+	int ret;
 	int val;
 
 	val = __mdiobus_c45_read(bus, phydev->mdio.addr, devad,
 				 regnum);
 
-	/* FIXME: verify if it's actually ok to limit this to MII_BMSR */
-	__mdiobus_write(bus, 0x0, MII_BMSR, 0x1);
+	/* AS21xx needs a post-read dummy write to keep later MDIO reads
+	 * stable. Use C22 BMSR to avoid side effects from writable registers.
+	 */
+	ret = __mdiobus_write(bus, 0x0, MII_BMSR, 0x1);
+
+	if (val < 0)
+		return val;
 
-	return val;
+	return ret ?: val;
 }
 
 static struct phy_driver as21xxx_drivers[] = {
